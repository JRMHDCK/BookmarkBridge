/* Introduction */
"help.introduction.overview" = "BookmarkBridge compare les favoris de Safari et de Google Chrome sur votre Mac. Il vous montre toujours les changements avant de les appliquer et conserve une sauvegarde restaurable avant toute écriture dans Chrome.";
"help.introduction.principles.title" = "Trois principes essentiels";
"help.introduction.principles.preview" = "Prévisualisation : vous voyez le contenu du plan avant de confirmer.";
"help.introduction.principles.local" = "Traitement local : vos favoris restent sur votre Mac et aucun compte BookmarkBridge n’est requis.";
"help.introduction.principles.backup" = "Protection : une sauvegarde est créée avant la modification du fichier Chrome.";
"help.callout.readonly.title" = "Safari reste en lecture seule";
"help.callout.readonly.body" = "La version actuelle lit Safari, mais n’y écrit jamais. La synchronisation appliquée ajoute uniquement à un profil Chrome local les favoris Safari qui y sont absents.";

/* Installation */
"help.installation.requirements" = "BookmarkBridge 0.9.1 nécessite macOS 26.5 ou une version ultérieure. L’application fonctionne sur les Mac Apple Silicon et Intel 64 bits.";
"help.installation.steps.title" = "Installer BookmarkBridge";
"help.installation.step.move" = "Placez BookmarkBridge dans le dossier Applications.";
"help.installation.step.open" = "Ouvrez l’application, puis confirmez son ouverture si macOS le demande.";
"help.installation.step.permissions" = "Suivez l’assistant de bienvenue. Les accès Safari et Chrome sont demandés séparément et restent sous votre contrôle.";
"help.installation.compatibility.title" = "Compatibilité";
"help.installation.compatibility.body" = "Safari est intégré à macOS. Google Chrome doit être installé uniquement si vous souhaitez lire ou mettre à jour ses favoris.";

/* Configuration and privacy */
"help.configuration.overview" = "BookmarkBridge utilise les réglages de sécurité recommandés. La configuration consiste principalement à sélectionner les emplacements Safari et Chrome que macOS autorise à l’application.";
"help.configuration.permissions.title" = "Configurer les autorisations";
"help.configuration.permission.safari" = "Dans Accueil, choisissez les favoris Safari lorsque la carte Autorisations le propose.";
"help.configuration.permission.chrome" = "Choisissez ensuite le dossier Chrome, puis le profil local voulu.";
"help.configuration.permission.verify" = "Vérifiez que les deux sources apparaissent comme autorisées avant d’ouvrir Synchronisation.";
"help.configuration.privacy.title" = "Confidentialité";
"help.configuration.privacy.body" = "Les autorisations sont stockées sous forme de références sécurisées gérées par macOS. BookmarkBridge ne téléverse pas vos favoris et ne dépend d’aucun service réseau.";

/* Safari */
"help.safari.overview" = "BookmarkBridge lit la bibliothèque locale de Safari afin d’afficher ses dossiers, ses favoris et les éléments absents de Chrome.";
"help.safari.authorization.title" = "Autoriser Safari";
"help.safari.authorization.open" = "Cliquez sur Choisir les favoris Safari.";
"help.safari.authorization.select" = "Sélectionnez le fichier Bookmarks.plist dans le dossier Safari de votre bibliothèque utilisateur.";
"help.safari.authorization.confirm" = "Validez la sélection. L’état Safari se recharge automatiquement.";
"help.safari.readonly.title" = "Aucune écriture dans Safari";
"help.safari.readonly.body" = "L’autorisation macOS permet l’accès au fichier sélectionné, mais la politique de BookmarkBridge maintient Safari strictement en lecture seule.";

/* Chrome */
"help.chrome.overview" = "Chrome peut contenir plusieurs profils. BookmarkBridge les découvre dans le dossier Chrome que vous avez explicitement sélectionné.";
"help.chrome.authorization.title" = "Autoriser Chrome";
"help.chrome.authorization.open" = "Cliquez sur Choisir le profil Chrome.";
"help.chrome.authorization.select" = "Sélectionnez le dossier Chrome dans Application Support/Google.";
"help.chrome.authorization.profile" = "Dans Synchronisation, vérifiez le nom du profil cible avant de confirmer.";
"help.chrome.closed.title" = "Fermez Safari et Chrome avant une écriture";
"help.chrome.closed.body" = "Safari et Chrome doivent être fermés pendant la synchronisation et la restauration. Cette précaution évite que les navigateurs et BookmarkBridge modifient les favoris en même temps.";

/* Synchronization */
"help.synchronization.overview" = "La synchronisation suit une séquence contrôlée. Le plan visible reste la référence : aucune opération supplémentaire n’est ajoutée au moment de l’écriture.";
"help.synchronization.workflow.title" = "Effectuer une première synchronisation";
"help.synchronization.step.reload" = "Actualisez Accueil pour lire les bibliothèques Safari et Chrome.";
"help.synchronization.step.review" = "Ouvrez Synchronisation et examinez le résumé ainsi que le nombre de changements.";
"help.synchronization.step.close" = "Fermez Safari et Chrome.";
"help.synchronization.step.confirm" = "Cliquez sur Synchroniser, puis confirmez le plan affiché.";
"help.synchronization.step.verify" = "Attendez le message de réussite et vérifiez que l’aperçu se recharge.";
"help.synchronization.additive.title" = "Synchronisation additive";
"help.synchronization.additive.body" = "La bêta ajoute à Chrome les favoris Safari absents. Elle ne supprime pas les favoris existants de Chrome et ne modifie pas Safari.";

/* Conflicts */
"help.conflicts.overview" = "Un conflit désigne une situation où BookmarkBridge ne peut pas choisir une action sûre sans information supplémentaire. La bêta privilégie l’absence d’écriture plutôt qu’une décision automatique risquée.";
"help.conflicts.behavior.title" = "Comportement de sécurité";
"help.conflicts.behavior.preview" = "Les différences sont présentées avant application.";
"help.conflicts.behavior.readonly" = "Une source ambiguë reste en lecture seule.";
"help.conflicts.behavior.choice" = "Si un profil n’est pas inscriptible, choisissez un autre profil local ou conservez-le en consultation.";
"help.conflicts.safety.title" = "Aucune résolution destructive";
"help.conflicts.safety.body" = "BookmarkBridge 0.9.1 ne résout pas un conflit en supprimant ou en écrasant silencieusement un favori.";

/* Chrome profiles */
"help.profiles.overview" = "Chaque profil Chrome possède son propre nom et son propre stockage. Vérifiez toujours le profil affiché dans l’aperçu avant de synchroniser.";
"help.profiles.selection.title" = "Types de profils";
"help.profiles.selection.local" = "Profil local : le fichier Bookmarks peut être sélectionné comme cible.";
"help.profiles.selection.account" = "Profil de compte : AccountBookmarks est lu mais reste en lecture seule.";
"help.profiles.selection.multiple" = "Plusieurs profils : chacun apparaît comme une source distincte dans BookmarkBridge.";
"help.profiles.ambiguous.title" = "Deux stockages non vides";
"help.profiles.ambiguous.body" = "Lorsqu’un profil possède à la fois Bookmarks et AccountBookmarks avec des données, BookmarkBridge le signale et refuse l’écriture afin de ne pas choisir arbitrairement.";

/* History */
"help.history.overview" = "La bêta affiche l’état et le résultat de l’opération dans la vue Synchronisation. Elle conserve également la dernière sauvegarde restaurable associée au profil cible.";
"help.history.available.title" = "Informations disponibles";
"help.history.available.result" = "Le nombre de favoris réellement ajoutés est affiché après l’opération.";
"help.history.available.backup" = "Le bouton Restaurer apparaît lorsqu’une sauvegarde valide est disponible.";
"help.history.available.refresh" = "Accueil et l’aperçu sont rechargés après une synchronisation ou une restauration.";
"help.history.beta.title" = "Historique détaillé";
"help.history.beta.body" = "Cette version ne propose pas encore de journal chronologique consultable. Elle n’affiche donc pas une liste d’opérations anciennes qui pourrait être incomplète.";

/* Backups */
"help.backups.overview" = "Avant toute écriture, BookmarkBridge crée une copie privée et horodatée du fichier Chrome d’origine. La sauvegarde est liée au profil exact qui a été modifié.";
"help.backups.restore.title" = "Restaurer une sauvegarde";
"help.backups.restore.close" = "Fermez Safari et Chrome.";
"help.backups.restore.open" = "Ouvrez Synchronisation et repérez le bouton Restaurer.";
"help.backups.restore.confirm" = "Lancez la restauration. BookmarkBridge replace atomiquement le fichier sauvegardé.";
"help.backups.restore.verify" = "Attendez la confirmation, puis ouvrez Chrome pour vérifier vos favoris.";
"help.backups.scope.title" = "Restauration ciblée";
"help.backups.scope.body" = "Une sauvegarde ne peut restaurer qu’un fichier correspondant au même profil Chrome. Cette vérification empêche une restauration croisée.";

/* FAQ */
"help.faq.safari.question" = "Pourquoi Safari demande-t-il une autorisation ?";
"help.faq.safari.answer" = "Le sandbox macOS interdit à une application d’ouvrir votre bibliothèque Safari sans sélection explicite. L’autorisation reste locale et peut être redemandée si le fichier est déplacé ou si macOS la révoque.";
"help.faq.chromeEmpty.question" = "Pourquoi Chrome apparaît-il vide ?";
"help.faq.chromeEmpty.answer" = "Vérifiez le profil sélectionné, puis actualisez Accueil. Un profil différent, un stockage de compte ou une autorisation devenue invalide peut expliquer l’absence de favoris.";
"help.faq.duplicateFolder.question" = "Pourquoi un dossier semble-t-il dupliqué ?";
"help.faq.duplicateFolder.answer" = "Deux dossiers peuvent porter le même nom tout en appartenant à des emplacements différents. BookmarkBridge conserve cette distinction et n’essaie pas de les fusionner d’après leur nom seul.";
"help.faq.sync.question" = "Comment fonctionne la synchronisation ?";
"help.faq.sync.answer" = "BookmarkBridge lit les deux bibliothèques, calcule un aperçu, attend votre confirmation, crée une sauvegarde puis ajoute à Chrome uniquement les favoris Safari absents.";
"help.faq.delete.question" = "Que se passe-t-il si je supprime un favori ?";
"help.faq.delete.answer" = "La bêta n’applique pas les suppressions. Un favori supprimé d’un navigateur n’est donc pas automatiquement supprimé de l’autre.";
"help.faq.profiles.question" = "Puis-je synchroniser plusieurs profils Chrome ?";
"help.faq.profiles.answer" = "BookmarkBridge peut lire plusieurs profils, mais chaque synchronisation vise un profil local précis. Vérifiez son nom dans l’aperçu avant de confirmer.";
"help.faq.restore.question" = "Comment restaurer une sauvegarde ?";
"help.faq.restore.answer" = "Fermez Safari et Chrome, ouvrez Synchronisation et utilisez Restaurer lorsque le bouton est disponible. La sauvegarde correspond au profil précédemment modifié.";
"help.faq.missing.question" = "Pourquoi certains favoris ne sont-ils pas synchronisés ?";
"help.faq.missing.answer" = "Les éléments déjà présents après normalisation d’URL ne sont pas ajoutés à nouveau. Les stockages AccountBookmarks et les profils ambigus restent également en lecture seule.";

/* Troubleshooting */
"help.troubleshooting.permission.title" = "Une autorisation n’est plus valide";
"help.troubleshooting.permission.body" = "Dans Accueil, utilisez le bouton d’autorisation correspondant et sélectionnez à nouveau le fichier Safari ou le dossier Chrome.";
"help.troubleshooting.chrome.title" = "La synchronisation demande de fermer Safari et Chrome";
"help.troubleshooting.chrome.body" = "Quittez Safari et Chrome avec Commande-Q, attendez quelques secondes, puis réessayez. Fermer uniquement leurs fenêtres ne quitte pas toujours les applications.";
"help.troubleshooting.empty.title" = "Aucun favori n’apparaît";
"help.troubleshooting.empty.body" = "Vérifiez la source et le profil, puis utilisez Actualiser. Si l’accès est signalé comme invalide, accordez-le de nouveau.";
"help.troubleshooting.retry.title" = "L’aperçu ne se charge pas";
"help.troubleshooting.retry.body" = "Actualisez les sources depuis Accueil, vérifiez que Safari et Chrome sont autorisés, puis revenez dans Synchronisation.";
"help.troubleshooting.safe.title" = "Vos données restent protégées";
"help.troubleshooting.safe.body" = "Un échec avant la confirmation n’écrit rien. Un échec après la création de la sauvegarde conserve celle-ci pour permettre une restauration.";

/* Glossary */
"help.glossary.preview.term" = "Prévisualisation";
"help.glossary.preview.definition" = "Liste calculée des changements proposés, affichée avant toute écriture.";
"help.glossary.profile.term" = "Profil Chrome";
"help.glossary.profile.definition" = "Espace Chrome séparé contenant ses propres favoris, réglages et données.";
"help.glossary.backup.term" = "Sauvegarde";
"help.glossary.backup.definition" = "Copie privée du fichier Chrome original créée avant une modification.";
"help.glossary.additive.term" = "Synchronisation additive";
"help.glossary.additive.definition" = "Mode qui ajoute les éléments absents sans supprimer les éléments existants.";
"help.glossary.securityScope.term" = "Autorisation sécurisée macOS";
"help.glossary.securityScope.definition" = "Référence persistante qui permet à une application sandboxée de rouvrir un emplacement choisi par l’utilisateur.";
"help.glossary.bse.term" = "BSE";
"help.glossary.bse.definition" = "Bookmark Synchronization Engine, le moteur qui compare les bibliothèques et prépare le plan de synchronisation.";

