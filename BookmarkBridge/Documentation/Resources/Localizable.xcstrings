    "help.conflicts.behavior.choice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a profile is not writable, choose another local profile or keep it for viewing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un profil n’est pas inscriptible, choisissez un autre profil local ou conservez-le en consultation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se puede escribir en un perfil, elija otro perfil local o guárdelo para verlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Profil nicht beschreibbar ist, wählen Sie ein anderes lokales Profil oder behalten Sie es zur Anzeige bei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un profilo non è scrivibile, scegli un altro profilo locale o conservalo per la visualizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um perfil não for gravável, escolha outro perfil local ou guarde-o para visualização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een profiel niet beschrijfbaar is, kies dan een ander lokaal profiel of bewaar het om te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli profilu nie można zapisać, wybierz inny profil lokalny lub zachowaj go do przeglądania."
          }
        }
      }
    },
    "help.conflicts.behavior.preview": {
