    "manual.quitSafariAndChromeWithCommandQ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Safari and Chrome with Command-Q. Verify that no windows or processes in these browsers remain active, and then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez Safari et Chrome avec Commande-Q. Vérifiez qu’aucune fenêtre ni aucun processus de ces navigateurs ne reste actif, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salga de Safari y Chrome con Command-Q. Verifique que ninguna ventana o proceso en estos navegadores permanezca activo y luego vuelva a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie Safari und Chrome mit Command-Q. Stellen Sie sicher, dass in diesen Browsern keine Fenster oder Prozesse mehr aktiv sind, und versuchen Sie es dann erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da Safari e Chrome con Comando-Q. Verificare che nessuna finestra o processo in questi browser rimanga attivo, quindi riprovare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia do Safari e do Chrome com Command-Q. Verifique se nenhuma janela ou processo nesses navegadores permanece ativo e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Safari en Chrome af met Command-Q. Controleer of er geen vensters of processen in deze browsers actief blijven en probeer het vervolgens opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ Safari i Chrome za pomocą Command-Q. Sprawdź, czy żadne okna ani procesy w tych przeglądarkach nie pozostają aktywne, a następnie spróbuj ponownie."
          }
        }
      }
    },
    "manual.readsSafariLibrariesAndChromeProfilesThat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads Safari libraries and Chrome profiles that you authorize."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les bibliothèques Safari et les profils Chrome que vous autorisez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las bibliotecas de Safari y los perfiles de Chrome que usted autorice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Safari-Bibliotheken und Chrome-Profile, die Sie autorisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le librerie Safari e i profili Chrome che autorizzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê bibliotecas do Safari e perfis do Chrome que você autoriza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest Safari-bibliotheken en Chrome-profielen die u autoriseert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje biblioteki Safari i profile Chrome, które autoryzowałeś."
          }
        }
      }
    },
    "manual.rechargeBothSourcesCheckTheirMetersAnd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge both sources, check their meters and take the time to read any warning boxes. If a profile is marked read-only, do not attempt to circumvent this protection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargez les deux sources, contrôlez leurs compteurs et prenez le temps de lire les éventuels encadrés d’avertissement. Si un profil est signalé en lecture seule, ne tentez pas de contourner cette protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recargue ambas fuentes, verifique sus medidores y tómese el tiempo para leer los cuadros de advertencia. Si un perfil está marcado como de sólo lectura, no intente eludir esta protección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie beide Quellen auf, überprüfen Sie die Messgeräte und nehmen Sie sich die Zeit, alle Warnfelder zu lesen. Versuchen Sie nicht, diesen Schutz zu umgehen, wenn ein Profil als schreibgeschützt markiert ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica entrambe le fonti, controlla i loro contatori e prenditi il tempo per leggere eventuali caselle di avviso. Se un profilo è contrassegnato come di sola lettura, non tentare di eludere questa protezione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarregue ambas as fontes, verifique seus medidores e reserve um tempo para ler as caixas de alerta. Se um perfil estiver marcado como somente leitura, não tente contornar essa proteção."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad beide bronnen op, controleer hun meters en neem de tijd om eventuele waarschuwingsvensters te lezen. Als een profiel als alleen-lezen is gemarkeerd, probeer dan niet deze beveiliging te omzeilen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naładuj oba źródła, sprawdź ich liczniki i poświęć trochę czasu na przeczytanie wszelkich ostrzeżeń. Jeśli profil jest oznaczony jako tylko do odczytu, nie próbuj obejść tego zabezpieczenia."
          }
        }
      }
    },
