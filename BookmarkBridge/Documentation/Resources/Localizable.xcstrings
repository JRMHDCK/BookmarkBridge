    "onboarding.workflow.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application analyzes, compares and previews. Nothing is written until you review and confirm the plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application analyse, compare et prévisualise. Rien n’est écrit tant que vous n’avez pas examiné puis confirmé le plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación analiza, compara y obtiene una vista previa. No se escribe nada hasta que revise y confirme el plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anwendung analysiert, vergleicht und zeigt eine Vorschau an. Es wird nichts geschrieben, bis Sie den Plan überprüfen und bestätigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'applicazione analizza, confronta e visualizza in anteprima. Non viene scritto nulla finché non rivedi e confermi il piano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo analisa, compara e visualiza. Nada está escrito até que você revise e confirme o plano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De applicatie analyseert, vergelijkt en previews. Er wordt niets geschreven totdat u het plan heeft beoordeeld en bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja analizuje, porównuje i podgląda. Nic nie jest napisane, dopóki nie przejrzysz i nie zatwierdzisz planu."
          }
        }
      }
    },
