    "help.history.beta.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version does not yet offer a searchable chronological log. It therefore does not display a list of old operations which could be incomplete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne propose pas encore de journal chronologique consultable. Elle n’affiche donc pas une liste d’opérations anciennes qui pourrait être incomplète."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión aún no ofrece un registro cronológico con capacidad de búsqueda. Por tanto, no muestra una lista de operaciones antiguas que podrían estar incompletas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version bietet noch kein durchsuchbares chronologisches Protokoll. Daher wird keine Liste alter Vorgänge angezeigt, die möglicherweise unvollständig sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non offre ancora un registro cronologico ricercabile. Pertanto non viene visualizzato l'elenco delle vecchie operazioni che potrebbero risultare incomplete."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão ainda não oferece um registro cronológico pesquisável. Portanto, não exibe uma lista de operações antigas que possam estar incompletas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie biedt nog geen doorzoekbaar chronologisch logboek. Er wordt daarom geen lijst met oude bewerkingen weergegeven die mogelijk onvolledig zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja nie oferuje jeszcze przeszukiwalnego dziennika chronologicznego. Dlatego nie wyświetla listy starych operacji, które mogły być niekompletne."
          }
        }
      }
    },
    "help.history.beta.title": {
      "extractionState": "manual",
      "localizations": {
