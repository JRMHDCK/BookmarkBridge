    "help.backups.restore.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the restore. BookmarkBridge atomically replaces the saved file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez la restauration. BookmarkBridge replace atomiquement le fichier sauvegardé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie la restauración. BookmarkBridge reemplaza atómicamente el archivo guardado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie die Wiederherstellung. BookmarkBridge ersetzt die gespeicherte Datei atomar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il ripristino. BookmarkBridge sostituisce atomicamente il file salvato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie a restauração. BookmarkBridge substitui atomicamente o arquivo salvo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start het herstel. BookmarkBridge vervangt atomair het opgeslagen bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij przywracanie. BookmarkBridge atomowo zastępuje zapisany plik."
          }
        }
      }
    },
