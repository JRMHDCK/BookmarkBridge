    "manual.chooseAllowAgainFromTheDashboardThen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Allow again from the dashboard, then select the same library. This operation does not modify any favorites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez de nouveau Autoriser dans le tableau de bord, puis sélectionnez la même bibliothèque. Cette opération ne modifie aucun favori."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija Permitir nuevamente en el panel y luego seleccione la misma biblioteca. Esta operación no modifica ningún favorito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
