    "manual.onlySafariAndGoogleChromeAreSupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Safari and Google Chrome are supported. Chrome AccountBookmarks remains read-only. There is no cloud, multi-machine, real-time, or background synchronization."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls Safari et Google Chrome sont pris en charge. Chrome AccountBookmarks reste en lecture seule. Il n’existe pas de synchronisation cloud, multi-machine, temps réel ou en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se admiten Safari y Google Chrome. Chrome AccountBookmarks sigue siendo de solo lectura. No hay sincronización en la nube, en varias máquinas, en tiempo real o en segundo plano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Safari und Google Chrome unterstützt. Chrome AccountBookmarks bleibt schreibgeschützt. Es gibt keine Cloud-, Mehrmaschinen-, Echtzeit- oder Hintergrundsynchronisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono supportati solo Safari e Google Chrome. I segnalibri dell'account Chrome rimangono di sola lettura. Non è disponibile alcuna sincronizzazione cloud, multi-macchina, in tempo reale o in background."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas Safari e Google Chrome são suportados. Chrome AccountBookmarks permanece somente leitura. Não há sincronização em nuvem, multimáquina, em tempo real ou em segundo plano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen Safari en Google Chrome worden ondersteund. Chrome AccountBookmarks blijft alleen-lezen. Er is geen cloud-, multi-machine-, realtime- of achtergrondsynchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługiwane są tylko przeglądarki Safari i Google Chrome. Zakładki konta Chrome pozostają tylko do odczytu. Nie ma synchronizacji w chmurze, na wielu komputerach, w czasie rzeczywistym ani w tle."
          }
        }
      }
    },
    "manual.openBookmarkBridgeFromTheApplicationsFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open BookmarkBridge from the Applications folder."
