    "manual.theBetaIsNotYetNotarizedBy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The beta is not yet notarized by Apple. The first macOS crash is therefore expected and does not require disabling Gatekeeper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bêta n’est pas encore notariée par Apple. Le premier blocage de macOS est donc attendu et ne nécessite pas de désactiver Gatekeeper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión beta aún no está certificada por Apple. Por lo tanto, se espera el primer fallo de macOS y no es necesario desactivar Gatekeeper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beta ist noch nicht von Apple notariell beglaubigt. Der erste Absturz von macOS wird daher erwartet und erfordert keine Deaktivierung von Gatekeeper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La beta non è ancora stata autenticata da Apple. È quindi previsto il primo crash di macOS e non richiede la disattivazione di Gatekeeper."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão beta ainda não foi autenticada pela Apple. A primeira falha do macOS é, portanto, esperada e não requer a desativação do Gatekeeper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bèta is nog niet notarieel bekrachtigd door Apple. De eerste macOS-crash wordt daarom verwacht en vereist niet dat Gatekeeper wordt uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja beta nie została jeszcze potwierdzona przez Apple. Oczekuje się zatem pierwszej awarii systemu macOS, która nie wymaga wyłączania Gatekeepera."
          }
        }
      }
    },
    "manual.theDashboardClearlyDistinguishesBetweenReadingComparison": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dashboard clearly distinguishes between reading, comparison and application. An analysis never modifies your data. Synchronization always requires explicit action after preview."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau de bord distingue clairement la lecture, la comparaison et l’application. Une analyse ne modifie jamais vos données. La synchronisation nécessite toujours une action explicite après l’aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel distingue claramente entre lectura, comparación y aplicación. Un análisis nunca modifica tus datos. La sincronización siempre requiere una acción explícita después de la vista previa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dashboard unterscheidet klar zwischen Lesen, Vergleichen und Anwenden. Eine Analyse verändert niemals Ihre Daten. Die Synchronisierung erfordert immer eine explizite Aktion nach der Vorschau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dashboard distingue chiaramente tra lettura, confronto e applicazione. Un'analisi non modifica mai i tuoi dati. La sincronizzazione richiede sempre un'azione esplicita dopo l'anteprima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel distingue claramente entre leitura, comparação e aplicação. Uma análise nunca modifica seus dados. A sincronização sempre requer ação explícita após a visualização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het dashboard maakt duidelijk onderscheid tussen lezen, vergelijken en toepassen. Een analyse wijzigt nooit uw gegevens. Synchronisatie vereist altijd expliciete actie na de preview."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deska rozdzielcza wyraźnie rozróżnia czytanie, porównywanie i stosowanie. Analiza nigdy nie modyfikuje Twoich danych. Synchronizacja zawsze wymaga jawnego działania po podglądzie."
          }
        }
      }
    },
    "manual.theMacOSSandboxPreventsAnAppFrom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The macOS sandbox prevents an app from freely accessing your files. So you explicitly choose each library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sandbox macOS empêche une application d’accéder librement à vos fichiers. Vous choisissez donc explicitement chaque bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona de pruebas de macOS impide que una aplicación acceda libremente a sus archivos. Entonces eliges explícitamente cada biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die macOS-Sandbox verhindert, dass eine App frei auf Ihre Dateien zugreift. Sie wählen also jede Bibliothek explizit aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sandbox di macOS impedisce a un'app di accedere liberamente ai tuoi file. Quindi scegli esplicitamente ciascuna libreria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sandbox do macOS impede que um aplicativo acesse livremente seus arquivos. Então você escolhe explicitamente cada biblioteca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De macOS-sandbox voorkomt dat een app vrije toegang heeft tot uw bestanden. Je kiest dus expliciet elke bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Piaskownica macOS uniemożliwia aplikacjom swobodny dostęp do Twoich plików. Więc jawnie wybierasz każdą bibliotekę."
          }
        }
      }
    },
    "manual.thePermissionHasProbablyExpiredOrThe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The permission has probably expired or the file has been moved. Choose Allow, then select Bookmarks.plist again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation a probablement expiré ou le fichier a été déplacé. Choisissez Autoriser, puis sélectionnez à nouveau Bookmarks.plist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probablemente el permiso haya caducado o el archivo se haya movido. Elija Permitir y luego seleccione Bookmarks.plist nuevamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung ist wahrscheinlich abgelaufen oder die Datei wurde verschoben. Wählen Sie „Zulassen“ und dann erneut „Bookmarks.plist“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilmente il permesso è scaduto o il file è stato spostato. Scegli Consenti, quindi seleziona nuovamente Bookmarks.plist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão provavelmente expirou ou o arquivo foi movido. Escolha Permitir e selecione Bookmarks.plist novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschijnlijk is de toestemming verlopen of is het bestand verplaatst. Kies Toestaan ​​en selecteer vervolgens opnieuw Bookmarks.plist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie prawdopodobnie wygasło lub plik został przeniesiony. Wybierz opcję Zezwól, a następnie ponownie wybierz opcję Bookmarks.plist."
          }
        }
      }
    },
    "manual.thePermissionIsSavedByMacOSIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The permission is saved by macOS in a secure form. BookmarkBridge does not browse your other documents or ask you to disable system protections."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation est enregistrée par macOS sous une forme sécurisée. BookmarkBridge ne parcourt pas vos autres documents et ne demande pas de désactiver les protections du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS guarda el permiso de forma segura. BookmarkBridge no explora sus otros documentos ni le pide que desactive las protecciones del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung wird von macOS in sicherer Form gespeichert. BookmarkBridge durchsucht Ihre anderen Dokumente nicht und fordert Sie nicht auf, den Systemschutz zu deaktivieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione viene salvata da macOS in un formato sicuro. BookmarkBridge non sfoglia gli altri tuoi documenti né ti chiede di disabilitare le protezioni del sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão é salva pelo macOS de forma segura. BookmarkBridge não navega em seus outros documentos nem solicita que você desative as proteções do sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toestemming wordt door macOS in een veilige vorm opgeslagen. BookmarkBridge bladert niet door uw andere documenten en vraagt ​​u ook niet om de systeembeveiliging uit te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie jest zapisywane przez macOS w bezpiecznej formie. BookmarkBridge nie przegląda innych dokumentów ani nie prosi o wyłączenie zabezpieczeń systemu."
          }
        }
      }
    },
    "manual.thePreviewMaySuggestRemovingItIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview may suggest removing it in the target browser to reflect the selected source. It is only applied after confirmation and saving of the target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu peut proposer sa suppression dans le navigateur cible afin de refléter la source sélectionnée. Elle n’est appliquée qu’après confirmation et sauvegarde de la cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa puede sugerir eliminarlo en el navegador de destino para reflejar la fuente seleccionada. Sólo se aplica después de confirmar y guardar el objetivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau schlägt möglicherweise vor, sie im Zielbrowser zu entfernen, um die ausgewählte Quelle wiederzugeben. Die Anwendung erfolgt erst nach Bestätigung und Speicherung des Ziels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anteprima potrebbe suggerire di rimuoverlo nel browser di destinazione per riflettere la fonte selezionata. Viene applicato solo dopo la conferma e il salvataggio del target."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização pode sugerir removê-lo do navegador de destino para refletir a fonte selecionada. Só é aplicado após confirmação e salvamento do alvo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het voorbeeld kan voorstellen om het in de doelbrowser te verwijderen om de geselecteerde bron weer te geven. Het wordt alleen toegepast na bevestiging en opslaan van het doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd może sugerować usunięcie go w przeglądarce docelowej w celu odzwierciedlenia wybranego źródła. Jest on stosowany dopiero po potwierdzeniu i zapisaniu celu."
          }
        }
      }
    },
    "manual.theProfileContainsLocalDataAndAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile contains local data and account data. BookmarkBridge keeps it read-only so as not to arbitrarily choose a source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil contient des données locales et des données de compte. BookmarkBridge le conserve en lecture seule afin de ne pas choisir arbitrairement une source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil contiene datos locales y datos de la cuenta. BookmarkBridge lo mantiene como de solo lectura para no elegir una fuente arbitrariamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil enthält lokale Daten und Kontodaten. BookmarkBridge hält es schreibgeschützt, um nicht willkürlich eine Quelle auszuwählen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo contiene dati locali e dati dell'account. BookmarkBridge lo mantiene di sola lettura per non scegliere arbitrariamente una fonte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil contém dados locais e dados da conta. BookmarkBridge o mantém somente leitura para não escolher uma fonte arbitrariamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel bevat lokale gegevens en accountgegevens. BookmarkBridge houdt het alleen-lezen om niet willekeurig een bron te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil zawiera dane lokalne i dane konta. BookmarkBridge utrzymuje go w trybie tylko do odczytu, aby nie wybierać źródła arbitralnie."
          }
        }
      }
    },
    "manual.theSafetyOfFavoritesTakesPrecedenceOver": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safety of favorites takes precedence over speed. If in doubt, cancel the operation and consult the view's context-sensitive help."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sécurité des favoris prime sur la rapidité. En cas de doute, annulez l’opération et consultez l’aide contextuelle de la vue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La seguridad de los favoritos tiene prioridad sobre la velocidad. En caso de duda, cancele la operación y consulte la ayuda contextual de la vista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheit der Favoriten geht vor der Geschwindigkeit. Brechen Sie im Zweifelsfall den Vorgang ab und konsultieren Sie die kontextbezogene Hilfe der Ansicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sicurezza dei favoriti ha la precedenza sulla velocità. In caso di dubbi, annullare l'operazione e consultare la guida sensibile al contesto della vista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A segurança dos favoritos tem precedência sobre a velocidade. Em caso de dúvida, cancele a operação e consulte a ajuda contextual da visualização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De veiligheid van favorieten heeft voorrang op snelheid. Als u twijfelt, annuleert u de bewerking en raadpleegt u de contextgevoelige hulp van de weergave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczeństwo faworytów ma pierwszeństwo przed szybkością. W razie wątpliwości anuluj operację i skorzystaj z pomocy kontekstowej widoku."
          }
        }
      }
    },
    "manual.theSetupLinksBookmarkBridgeToChosenLibraries": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setup links BookmarkBridge to chosen libraries using macOS's secure file picker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration relie BookmarkBridge aux bibliothèques choisies grâce au sélecteur de fichiers sécurisé de macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración vincula BookmarkBridge con las bibliotecas elegidas mediante el selector de archivos seguro de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Setup verknüpft BookmarkBridge mithilfe der sicheren Dateiauswahl von macOS mit ausgewählten Bibliotheken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione collega BookmarkBridge alle librerie scelte utilizzando il selettore di file sicuro di macOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração vincula o BookmarkBridge às bibliotecas escolhidas usando o seletor de arquivos seguro do macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De installatie koppelt BookmarkBridge aan gekozen bibliotheken met behulp van de veilige bestandskiezer van macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja łączy BookmarkBridge z wybranymi bibliotekami za pomocą bezpiecznego selektora plików systemu macOS."
          }
        }
      }
    },
    "manual.thisMessageAppearsBecauseThisBetaHas": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message appears because this beta has not yet been signed or notarized by Apple. Proceed only if the displayed name is BookmarkBridge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message apparaît parce que cette bêta n’est pas encore signée ni notariée par Apple. Poursuivez uniquement si le nom affiché est BookmarkBridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje aparece porque esta versión beta aún no ha sido firmada ni certificada ante notario por Apple. Continúe solo si el nombre mostrado es BookmarkBridge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Meldung erscheint, weil diese Beta noch nicht von Apple unterzeichnet oder notariell beglaubigt wurde. Fahren Sie nur fort, wenn der angezeigte Name BookmarkBridge ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo messaggio appare perché questa beta non è stata ancora firmata o autenticata da Apple. Procedere solo se il nome visualizzato è BookmarkBridge."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta mensagem aparece porque este beta ainda não foi assinado ou autenticado pela Apple. Prossiga apenas se o nome exibido for BookmarkBridge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bericht verschijnt omdat deze bèta nog niet is ondertekend of notarieel bekrachtigd door Apple. Ga alleen verder als de weergegeven naam BookmarkBridge is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten komunikat pojawia się, ponieważ wersja beta nie została jeszcze podpisana ani potwierdzona notarialnie przez firmę Apple. Kontynuuj tylko wtedy, gdy wyświetlana nazwa to BookmarkBridge."
          }
        }
      }
    },
    "manual.thisProcedureOnlyAllowsBookmarkBridgeItDoes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This procedure only allows BookmarkBridge. It does not disable Gatekeeper or other application security controls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette procédure autorise uniquement BookmarkBridge. Elle ne désactive ni Gatekeeper ni les contrôles de sécurité des autres applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este procedimiento sólo permite BookmarkBridge. No desactiva Gatekeeper ni otros controles de seguridad de aplicaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Verfahren ermöglicht nur BookmarkBridge. Gatekeeper oder andere Anwendungssicherheitskontrollen werden dadurch nicht deaktiviert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa procedura consente solo BookmarkBridge. Non disabilita Gatekeeper o altri controlli di sicurezza dell'applicazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este procedimento permite apenas BookmarkBridge. Ele não desativa o Gatekeeper ou outros controles de segurança de aplicativos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze procedure staat alleen BookmarkBridge toe. Het schakelt Gatekeeper of andere beveiligingscontroles van applicaties niet uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta procedura umożliwia tylko BookmarkBridge. Nie wyłącza funkcji Gatekeeper ani innych zabezpieczeń aplikacji."
          }
        }
      }
    },
    "manual.thisVersionSupportsSafariAndGoogleChrome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version supports Safari and Google Chrome. Firefox, Edge and other browsers are not yet available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version prend en charge Safari et Google Chrome. Firefox, Edge et les autres navigateurs ne sont pas encore disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión es compatible con Safari y Google Chrome. Firefox, Edge y otros navegadores aún no están disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version unterstützt Safari und Google Chrome. Firefox, Edge und andere Browser sind noch nicht verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione supporta Safari e Google Chrome. Firefox, Edge e altri browser non sono ancora disponibili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão suporta Safari e Google Chrome. Firefox, Edge e outros navegadores ainda não estão disponíveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie ondersteunt Safari en Google Chrome. Firefox, Edge en andere browsers zijn nog niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja obsługuje Safari i Google Chrome. Firefox, Edge i inne przeglądarki nie są jeszcze dostępne."
          }
        }
      }
    },
    "manual.toRemember": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To remember"
          }
        },
        "fr": {
