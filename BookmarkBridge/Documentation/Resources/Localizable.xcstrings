    "help.faq.delete.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depending on the direction chosen and the selection, the preview may suggest deleting this favorite in the target browser. The deletion is only applied after your confirmation and the target is saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon le sens choisi et la sélection, l’aperçu peut proposer de supprimer ce favori dans le navigateur cible. La suppression n’est appliquée qu’après votre confirmation et la sauvegarde de la cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependiendo de la dirección elegida y la selección, la vista previa puede sugerir eliminar este favorito en el navegador de destino. La eliminación solo se aplica después de su confirmación y se guarda el objetivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängig von der gewählten Richtung und der Auswahl kann die Vorschau vorschlagen, diesen Favoriten im Zielbrowser zu löschen. Erst nach Ihrer Bestätigung wird die Löschung übernommen und das Ziel gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A seconda della direzione scelta e della selezione, l'anteprima potrebbe suggerire di eliminare questo preferito nel browser di destinazione. La cancellazione viene applicata solo dopo la tua conferma e il target viene salvato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependendo da direção escolhida e da seleção, a visualização pode sugerir a exclusão deste favorito no navegador de destino. A exclusão só é aplicada após sua confirmação e o destino é salvo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhankelijk van de gekozen richting en de selectie kan het voorbeeld voorstellen om deze favoriet in de doelbrowser te verwijderen. De verwijdering wordt pas toegepast na uw bevestiging en het doel is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zależności od wybranego kierunku i zaznaczenia podgląd może sugerować usunięcie tego ulubionego w przeglądarce docelowej. Usunięcie nastąpi dopiero po potwierdzeniu i zapisaniu celu."
          }
        }
      }
    },
