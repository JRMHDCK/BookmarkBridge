    "help.troubleshooting.chrome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Safari and Chrome with Command-Q, wait a few seconds, then try again. Closing only their windows doesn't always quit applications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez Safari et Chrome avec Commande-Q, attendez quelques secondes, puis réessayez. Fermer uniquement leurs fenêtres ne quitte pas toujours les applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salga de Safari y Chrome con Command-Q, espere unos segundos y vuelva a intentarlo. Cerrar sólo sus ventanas no siempre cierra las aplicaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie Safari und Chrome mit Befehl-Q, warten Sie ein paar Sekunden und versuchen Sie es dann erneut. Wenn Sie nur die Fenster schließen, werden Anwendungen nicht immer beendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da Safari e Chrome con Comando-Q, attendi qualche secondo, quindi riprova. Chiudendo solo le finestre non sempre si escono dalle applicazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia do Safari e do Chrome com Command-Q, aguarde alguns segundos e tente novamente. Fechar apenas as janelas nem sempre fecha os aplicativos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Safari en Chrome af met Command-Q, wacht een paar seconden en probeer het opnieuw. Als u alleen hun vensters sluit, worden toepassingen niet altijd afgesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij Safari i Chrome za pomocą Command-Q, poczekaj kilka sekund, a następnie spróbuj ponownie. Zamknięcie samych okien nie zawsze powoduje zamknięcie aplikacji."
          }
        }
      }
    },
    "help.troubleshooting.chrome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization requires closing Safari and Chrome"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation demande de fermer Safari et Chrome"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización requiere cerrar Safari y Chrome"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Synchronisierung müssen Safari und Chrome geschlossen werden"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione richiede la chiusura di Safari e Chrome"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização requer o fechamento do Safari e do Chrome"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor synchronisatie zijn Safari en Chrome vereist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja wymaga zamknięcia Safari i Chrome"
          }
        }
      }
    },
    "help.troubleshooting.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the source and profile, then use Refresh. If access is marked as invalid, grant it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la source et le profil, puis utilisez Actualiser. Si l’accès est signalé comme invalide, accordez-le de nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la fuente y el perfil, luego use Actualizar. Si el acceso está marcado como no válido, concédelo nuevamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Quelle und das Profil und verwenden Sie dann „Aktualisieren“. Wenn der Zugriff als ungültig markiert ist, gewähren Sie ihn erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l'origine e il profilo, quindi utilizza Aggiorna. Se l'accesso è contrassegnato come non valido, concederlo nuovamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a origem e o perfil e use Atualizar. Se o acesso for marcado como inválido, conceda-o novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de bron en het profiel en gebruik vervolgens Vernieuwen. Als de toegang als ongeldig is gemarkeerd, verleent u deze opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź źródło i profil, a następnie użyj opcji Odśwież. Jeśli dostęp zostanie oznaczony jako nieważny, przyznaj go ponownie."
          }
        }
      }
    },
    "help.troubleshooting.empty.title": {
