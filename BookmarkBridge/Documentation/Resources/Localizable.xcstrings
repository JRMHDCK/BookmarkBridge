    "manual.tryOpening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try opening"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenter l’ouverture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta abrir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es zu öffnen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova ad aprire"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente abrir"
          }
        },
        "nl": {
