    "manual.itIsExcludedFromComparisonPreviewAnd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is excluded from comparison, preview and transaction. Unchecking it never causes it to be deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est exclu de la comparaison, de l’aperçu et de la transaction. Le décocher ne provoque jamais sa suppression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está excluido de comparación, vista previa y transacción. Desmarcarlo nunca provoca que se elimine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist vom Vergleich, der Vorschau und der Transaktion ausgeschlossen. Wenn Sie das Kontrollkästchen deaktivieren, wird es niemals gelöscht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È escluso dal confronto, dall'anteprima e dalla transazione. Deselezionandolo non verrà mai eliminato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É excluído da comparação, visualização e transação. Desmarcá-lo nunca faz com que ele seja excluído."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is uitgesloten van vergelijking, preview en transactie. Als u het vinkje weghaalt, wordt het nooit verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest wyłączony z porównania, podglądu i transakcji. Odznaczenie go nigdy nie powoduje jego usunięcia."
          }
        }
      }
    },
