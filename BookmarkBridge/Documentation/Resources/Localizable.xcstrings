    "onboarding.safari.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the wizard, select Bookmarks.plist when the Permissions card prompts. Safari can then be used as a synchronization source or target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’assistant, sélectionnez Bookmarks.plist lorsque la carte Autorisations le demande. Safari pourra ensuite servir de source ou de cible de synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del asistente, seleccione Bookmarks.plist cuando se lo solicite la tarjeta de Permisos. Luego, Safari se puede utilizar como fuente o destino de sincronización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie nach dem Assistenten Bookmarks.plist aus, wenn Sie auf der Berechtigungskarte dazu aufgefordert werden. Safari kann dann als Synchronisationsquelle oder -ziel verwendet werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la procedura guidata, seleziona Bookmarks.plist quando richiesto dalla scheda Autorizzazioni. Safari può quindi essere utilizzato come origine o destinazione della sincronizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após o assistente, selecione Bookmarks.plist quando o cartão Permissões solicitar. O Safari pode então ser usado como fonte ou destino de sincronização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na de wizard selecteert u Bookmarks.plist wanneer de machtigingskaart daarom vraagt. Safari kan dan worden gebruikt als synchronisatiebron of doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uruchomieniu kreatora wybierz Bookmarks.plist, gdy zostanie wyświetlony monit na karcie Uprawnienia. Safari może następnie służyć jako źródło lub cel synchronizacji."
          }
        }
      }
    },
