    "whatsNew.introduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This first public beta brings together two-way synchronization, detailed selection, the native interface and complete local documentation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette première bêta publique réunit la synchronisation bidirectionnelle, la sélection détaillée, l’interface native et une documentation locale complète."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta primera versión beta pública reúne sincronización bidireccional, selección detallada, interfaz nativa y documentación local completa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese erste öffentliche Beta vereint bidirektionale Synchronisierung, detaillierte Auswahl, die native Schnittstelle und vollständige lokale Dokumentation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa prima beta pubblica riunisce la sincronizzazione bidirezionale, la selezione dettagliata, l'interfaccia nativa e la documentazione locale completa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
