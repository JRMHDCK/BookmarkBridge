            "value": "Suchen Sie in der Hilfe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nell'aiuto"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise na ajuda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek in hulp"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj w pomocy"
          }
        }
      }
    },
    "help.synchronization.bidirectional.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen direction determines the source and the target. The plan may suggest address creations, deletions, moves, renames or updates in the target browser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sens choisi détermine la source et la cible. Le plan peut proposer des créations, suppressions, déplacements, renommages ou mises à jour d’adresse dans le navigateur cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección elegida determina la fuente y el objetivo. El plan puede sugerir la creación, eliminación, movimiento, cambio de nombre o actualización de direcciones en el navegador de destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Richtung bestimmt die Quelle und das Ziel. Der Plan kann das Erstellen, Löschen, Verschieben, Umbenennen oder Aktualisieren von Adressen im Zielbrowser vorschlagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La direzione scelta determina la fonte e la destinazione. Il piano può suggerire creazioni di indirizzi, eliminazioni, spostamenti, rinominazioni o aggiornamenti nel browser di destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A direção escolhida determina a origem e o alvo. O plano pode sugerir criações, exclusões, movimentações, renomeações ou atualizações de endereços no navegador de destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekozen richting bepaalt de bron en het doel. Het plan kan het maken, verwijderen, verplaatsen, hernoemen of bijwerken van adressen in de doelbrowser voorstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany kierunek określa źródło i cel. Plan może sugerować tworzenie, usuwanie, przenoszenie, zmianę nazwy lub aktualizację adresu w przeglądarce docelowej."
          }
        }
      }
    },
    "help.synchronization.bidirectional.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-way sync"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation bidirectionnelle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización bidireccional"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei-Wege-Synchronisierung"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione bidirezionale"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronização bidirecional"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie in twee richtingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja dwukierunkowa"
          }
        }
      }
    },
    "help.synchronization.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization follows a controlled sequence. The visible plan remains the reference: no additional operation is added at the time of writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation suit une séquence contrôlée. Le plan visible reste la référence : aucune opération supplémentaire n’est ajoutée au moment de l’écriture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización sigue una secuencia controlada. El plano visible sigue siendo la referencia: no se ha añadido ninguna operación adicional en el momento de escribir este artículo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung folgt einem kontrollierten Ablauf. Der sichtbare Plan bleibt die Referenz: Zum Zeitpunkt des Schreibens wurde kein zusätzlicher Vorgang hinzugefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione segue una sequenza controllata. La pianta visibile rimane il riferimento: nessuna operazione aggiuntiva viene aggiunta nel momento in cui scriviamo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização segue uma sequência controlada. O plano visível continua sendo a referência: nenhuma operação adicional foi adicionada no momento da escrita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De synchronisatie volgt een gecontroleerde volgorde. Het zichtbare plan blijft de referentie: er wordt op het moment van schrijven geen extra handeling toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja następuje według kontrolowanej sekwencji. Widoczny plan pozostaje punktem odniesienia: w chwili pisania tego tekstu nie są dodawane żadne dodatkowe operacje."
          }
        }
      }
    },
    "help.synchronization.step.close": {
