            "value": "Refresh the sources and try again. Your existing favorites remain unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisez les sources et réessayez. Vos favoris existants restent inchangés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza las fuentes y vuelve a intentarlo. Tus favoritos existentes permanecen sin cambios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Quellen und versuchen Sie es erneut. Ihre bestehenden Favoriten bleiben unverändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i sorgenti e riprova. I tuoi preferiti esistenti rimangono invariati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize as fontes e tente novamente. Seus favoritos existentes permanecem inalterados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
