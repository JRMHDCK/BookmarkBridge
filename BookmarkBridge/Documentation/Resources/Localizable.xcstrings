    "manual.afterPlacingBookmarkBridgeInApplicationsOpenThe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After placing BookmarkBridge in Applications, open the app from there. When macOS displays “BookmarkBridge item not open,” click Done."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir placé BookmarkBridge dans Applications, ouvrez l’app depuis ce dossier. Lorsque macOS affiche « Élément BookmarkBridge non ouvert », cliquez sur Terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de colocar BookmarkBridge en Aplicaciones, abra la aplicación desde allí. Cuando macOS muestre \"El elemento BookmarkBridge no está abierto\", haga clic en Listo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem Sie BookmarkBridge in den Anwendungen platziert haben, öffnen Sie die App von dort aus. Wenn macOS „BookmarkBridge-Element nicht geöffnet“ anzeigt, klicken Sie auf „Fertig“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver posizionato BookmarkBridge in Applicazioni, apri l'app da lì. Quando macOS visualizza \"Elemento BookmarkBridge non aperto\", fai clic su Fine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de colocar o BookmarkBridge em Aplicativos, abra o aplicativo a partir daí. Quando o macOS exibir “Item BookmarkBridge não aberto”, clique em Concluído."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat u BookmarkBridge in Applicaties hebt geplaatst, opent u vanaf daar de app. Wanneer macOS 'BookmarkBridge-item niet geopend' weergeeft, klikt u op 'Gereed'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po umieszczeniu BookmarkBridge w Aplikacjach otwórz stamtąd aplikację. Gdy system macOS wyświetli komunikat „Element BookmarkBridge nie jest otwarty”, kliknij Gotowe."
          }
        }
      }
    },
    "manual.allProcessingHappensLocallyOnYourMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All processing happens locally on your Mac. This guide is available without an Internet connection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le traitement s’effectue localement sur votre Mac. Ce guide est disponible sans connexion Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el procesamiento se realiza localmente en tu Mac. Esta guía está disponible sin conexión a Internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte Verarbeitung erfolgt lokal auf Ihrem Mac. Dieses Handbuch ist ohne Internetverbindung verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l'elaborazione avviene localmente sul tuo Mac. Questa guida è disponibile senza una connessione Internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o processamento acontece localmente no seu Mac. Este guia está disponível sem conexão com a Internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verwerking gebeurt lokaal op uw Mac. Deze handleiding is beschikbaar zonder internetverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całe przetwarzanie odbywa się lokalnie na komputerze Mac. Ten przewodnik jest dostępny bez połączenia z Internetem."
          }
        }
      }
    },
    "manual.allowsYouToSelectProfilesFoldersAnd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows you to select profiles, folders and favorites to synchronize."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de sélectionner les profils, dossiers et favoris à synchroniser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le permite seleccionar perfiles, carpetas y favoritos para sincronizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht die Auswahl von Profilen, Ordnern und Favoriten zur Synchronisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di selezionare profili, cartelle e preferiti da sincronizzare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite selecionar perfis, pastas e favoritos para sincronizar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee kunt u profielen, mappen en favorieten selecteren om te synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umożliwia wybór profili, folderów i ulubionych do synchronizacji."
          }
        }
      }
    },
    "manual.alwaysReviewThePreviewBeforeConfirming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always review the preview before confirming."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez toujours l’aperçu avant de confirmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise siempre la vista previa antes de confirmar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich vor der Bestätigung immer die Vorschau an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi sempre l'anteprima prima di confermare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre revise a visualização antes de confirmar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer altijd het voorbeeld voordat u bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze przeglądaj podgląd przed potwierdzeniem."
          }
        }
      }
    },
    "manual.anAnalysisAlwaysHasNoEffectOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An analysis always has no effect on the data. Only the preview confirmation button authorizes writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse est toujours sans effet sur les données. Seul le bouton de confirmation de l’aperçu autorise une écriture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un análisis siempre no tiene ningún efecto sobre los datos. Sólo el botón de confirmación de vista previa autoriza la escritura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Analyse hat immer keine Auswirkung auf die Daten. Nur die Vorschau-Bestätigungsschaltfläche berechtigt zum Schreiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'analisi non ha sempre alcun effetto sui dati. Solo il pulsante di conferma dell'anteprima autorizza la scrittura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma análise sempre não tem efeito sobre os dados. Somente o botão de confirmação de visualização autoriza a escrita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een analyse heeft altijd geen effect op de data. Alleen de voorbeeldbevestigingsknop geeft toestemming voor schrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza zawsze nie ma wpływu na dane. Dopiero przycisk potwierdzenia podglądu upoważnia do zapisu."
          }
        }
      }
    },
    "manual.anUncheckedItemIsIgnoredEntirelyBy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unchecked item is ignored entirely by the comparison and transaction. It is never deleted just because it is unchecked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément décoché est entièrement ignoré par la comparaison et la transaction. Il n’est jamais supprimé uniquement parce qu’il est décoché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comparación y la transacción ignoran por completo un elemento no marcado. Nunca se elimina sólo porque no está marcado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ungeprüfter Artikel wird vom Vergleich und der Transaktion vollständig ignoriert. Es wird niemals gelöscht, nur weil es nicht markiert ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento non selezionato viene completamente ignorato dal confronto e dalla transazione. Non viene mai eliminato solo perché non è selezionato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item não verificado é totalmente ignorado pela comparação e transação. Ele nunca é excluído apenas porque está desmarcado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een niet-aangevinkt item wordt volledig genegeerd door de vergelijking en transactie. Het wordt nooit verwijderd alleen omdat het niet is aangevinkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycja niezaznaczona jest całkowicie ignorowana podczas porównania i transakcji. Nigdy nie jest usuwany tylko dlatego, że nie jest zaznaczony."
          }
        }
      }
    },
