    "safariImport.preview.additiveNotice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der native Safari-HTML-Import ist additiv: Nur Erstellungen werden importiert. Löschungen, Verschiebungen, Umbenennungen und Aktualisierungen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari’s native HTML import is additive: only creations are imported. Deletions, moves, renames, and updates remain unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La importación HTML nativa de Safari es aditiva: solo se importan las creaciones. Las eliminaciones, movimientos, cambios de nombre y actualizaciones no se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’import HTML natif de Safari est additif : seules les créations sont importées. Les suppressions, déplacements, renommages et mises à jour restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importazione HTML nativa di Safari è additiva: vengono importate solo le creazioni. Eliminazioni, spostamenti, rinomine e aggiornamenti restano invariati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ingebouwde HTML-import van Safari is aanvullend: alleen nieuwe items worden geïmporteerd. Verwijderingen, verplaatsingen, naamswijzigingen en updates blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natywny import HTML Safari jest addytywny: importowane są tylko nowe elementy. Usunięcia, przeniesienia, zmiany nazw i aktualizacje pozostają bez zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A importação HTML nativa do Safari é aditiva: apenas as criações são importadas. Eliminações, deslocações, alterações de nome e atualizações permanecem inalteradas."
          }
        }
      }
    },
