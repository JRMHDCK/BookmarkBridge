    "onboarding.finish.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start by granting permissions in Home. You can find this guide from Settings and all the documentation from the Help menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par accorder les autorisations dans Accueil. Vous pourrez retrouver ce guide depuis Réglages et toute la documentation depuis le menu Aide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience otorgando permisos en Inicio. Puedes encontrar esta guía en Configuración y toda la documentación en el menú Ayuda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit der Erteilung von Berechtigungen in Home. Sie finden diese Anleitung in den Einstellungen und die gesamte Dokumentation im Hilfemenü."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia concedendo le autorizzazioni in Home. Puoi trovare questa guida da Impostazioni e tutta la documentazione dal menu Aiuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece concedendo permissões na página inicial. Você pode encontrar este guia em Configurações e toda a documentação no menu Ajuda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met het verlenen van machtigingen in Home. U kunt deze handleiding vinden via Instellingen en alle documentatie via het Help-menu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od przyznania uprawnień na stronie głównej. Ten przewodnik znajdziesz w Ustawieniach, a całą dokumentację w menu Pomoc."
          }
        }
      }
    },
