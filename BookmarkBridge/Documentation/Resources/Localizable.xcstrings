            "state": "translated",
            "value": "Click Synchronize, then confirm the displayed plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Synchroniser, puis confirmez le plan affiché."
          }
        },
        "es": {
