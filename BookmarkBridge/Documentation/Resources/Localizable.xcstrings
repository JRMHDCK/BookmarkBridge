    "help.troubleshooting.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Home, use the corresponding permission button and select the Safari file or Chrome folder again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Accueil, utilisez le bouton d’autorisation correspondant et sélectionnez à nouveau le fichier Safari ou le dossier Chrome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Inicio, use el botón de permiso correspondiente y seleccione nuevamente el archivo Safari o la carpeta Chrome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie in Home die entsprechende Berechtigungsschaltfläche und wählen Sie erneut die Safari-Datei oder den Chrome-Ordner aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Home, utilizza il pulsante di autorizzazione corrispondente e seleziona nuovamente il file Safari o la cartella Chrome."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na página inicial, use o botão de permissão correspondente e selecione o arquivo Safari ou a pasta do Chrome novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik in Home de bijbehorende toestemmingsknop en selecteer opnieuw het Safari-bestand of de Chrome-map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stronie głównej użyj odpowiedniego przycisku uprawnień i ponownie wybierz plik Safari lub folder Chrome."
          }
        }
      }
    },
