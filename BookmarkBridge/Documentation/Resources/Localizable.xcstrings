    "manual.foldersWithTheSameNameCanBelong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders with the same name can belong to different paths. Consult their hierarchy in the explorer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des dossiers portant le même nom peuvent appartenir à des chemins différents. Consultez leur hiérarchie dans l’explorateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas con el mismo nombre pueden pertenecer a rutas diferentes. Consulta su jerarquía en el explorador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner mit demselben Namen können zu unterschiedlichen Pfaden gehören. Konsultieren Sie ihre Hierarchie im Explorer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle con lo stesso nome possono appartenere a percorsi diversi. Consulta la loro gerarchia nell'esploratore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas com o mesmo nome podem pertencer a caminhos diferentes. Consulte sua hierarquia no explorador."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen met dezelfde naam kunnen tot verschillende paden behoren. Raadpleeg hun hiërarchie in de verkenner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery o tej samej nazwie mogą należeć do różnych ścieżek. Sprawdź ich hierarchię w eksploratorze."
          }
        }
      }
    },
    "manual.followTheWelcomeGuideWhenFirstLaunching": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the welcome guide when first launching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le guide de bienvenue lors du premier lancement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga la guía de bienvenida cuando inicie por primera vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befolgen Sie beim ersten Start die Begrüßungsanleitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la guida di benvenuto al primo avvio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga o guia de boas-vindas ao lançar pela primeira vez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de welkomstgids wanneer u voor het eerst start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas pierwszego uruchomienia postępuj zgodnie z przewodnikiem powitalnym."
          }
        }
      }
    },
    "manual.forInformationAdaptedToTheScreenDisplayed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For information adapted to the screen displayed, use the help button “?” \". The Help Center is also available in the Help menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une information adaptée à l’écran affiché, utilisez le bouton d’aide « ? ». Le centre d’aide est également disponible dans le menu Aide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para obtener información adaptada a la pantalla mostrada, utilice el botón de ayuda “?” \". El Centro de ayuda también está disponible en el menú Ayuda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um an den angezeigten Bildschirm angepasste Informationen zu erhalten, verwenden Sie die Hilfeschaltfläche „?“ \". Das Hilfecenter ist auch im Hilfemenü verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per informazioni adatte alla schermata visualizzata, utilizzare il pulsante di aiuto “?” \". Il Centro assistenza è disponibile anche nel menu Aiuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para obter informações adaptadas à tela exibida, utilize o botão de ajuda “?” \". A Central de Ajuda também está disponível no menu Ajuda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor informatie aangepast aan het weergegeven scherm, gebruikt u de helpknop “?” \". Het Helpcentrum is ook beschikbaar in het Help-menu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uzyskać informacje dostosowane do wyświetlanego ekranu, użyj przycisku pomocy „?” ”. Centrum pomocy jest także dostępne w menu Pomoc."
          }
        }
      }
    },
