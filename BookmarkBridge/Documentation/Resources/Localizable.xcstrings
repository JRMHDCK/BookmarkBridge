    "error.unreadable.solution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the chosen location, then refresh. Do not edit the file manually."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’emplacement choisi, puis actualisez. Ne modifiez pas le fichier manuellement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la ubicación elegida y luego actualice. No edite el archivo manualmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie den ausgewählten Speicherort und aktualisieren Sie ihn anschließend. Bearbeiten Sie die Datei nicht manuell."
