    "manual.aFewSimpleHabitsMakeEverySync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few simple habits make every sync easier to check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques habitudes simples rendent chaque synchronisation plus facile à vérifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos hábitos simples hacen que cada sincronización sea más fácil de verificar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar einfache Gewohnheiten erleichtern die Überprüfung jeder Synchronisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune semplici abitudini rendono ogni sincronizzazione più facile da controllare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns hábitos simples tornam cada sincronização mais fácil de verificar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar eenvoudige gewoonten maken elke synchronisatie gemakkelijker te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka prostych nawyków sprawia, że każdą synchronizację łatwiej sprawdzić."
          }
        }
      }
    },
    "manual.aSafariOrChromeBackupPrecedesAny": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Safari or Chrome backup precedes any changes to the target browser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde de Safari ou de Chrome précède toute modification du navigateur cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad de Safari o Chrome precede a cualquier cambio en el navegador de destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor allen Änderungen am Zielbrowser wird ein Safari- oder Chrome-Backup erstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un backup di Safari o Chrome precede qualsiasi modifica al browser di destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup do Safari ou Chrome precede qualquer alteração no navegador de destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Safari- of Chrome-back-up gaat vooraf aan eventuele wijzigingen in de doelbrowser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa przeglądarki Safari lub Chrome poprzedza wszelkie zmiany w przeglądarce docelowej."
          }
        }
      }
    },
    "manual.afterASyncCheckAFewBookmarks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a sync, check a few bookmarks in Safari or the target Chrome profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une synchronisation, vérifiez quelques favoris dans Safari ou dans le profil Chrome cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de una sincronización, verifique algunos favoritos en Safari o en el perfil de Chrome de destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie nach der Synchronisierung einige Lesezeichen in Safari oder im Ziel-Chrome-Profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una sincronizzazione, controlla alcuni segnalibri in Safari o nel profilo Chrome di destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a sincronização, verifique alguns favoritos no Safari ou no perfil de destino do Chrome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer na een synchronisatie een paar bladwijzers in Safari of het doel-Chrome-profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po synchronizacji sprawdź kilka zakładek w przeglądarce Safari lub docelowym profilu Chrome."
          }
        }
      }
    },
