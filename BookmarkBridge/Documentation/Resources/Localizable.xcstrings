    "manual.nextToTheMessageBookmarkBridgeHasBeen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next to the message “BookmarkBridge has been blocked to protect your Mac,” click Open anyway. The button appears only after the first opening attempt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À côté du message « BookmarkBridge a été bloqué pour protéger votre Mac », cliquez sur Ouvrir quand même. Le bouton apparaît seulement après la première tentative d’ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto al mensaje \"BookmarkBridge ha sido bloqueado para proteger tu Mac\", haz clic en Abrir de todos modos. El botón aparece sólo después del primer intento de apertura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie neben der Meldung „BookmarkBridge wurde zum Schutz Ihres Mac blockiert“ auf „Trotzdem öffnen“. Der Button erscheint erst nach dem ersten Öffnungsversuch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accanto al messaggio \"BookmarkBridge è stato bloccato per proteggere il tuo Mac\", fai clic su Apri comunque. Il pulsante appare solo dopo il primo tentativo di apertura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao lado da mensagem “BookmarkBridge foi bloqueado para proteger seu Mac”, clique em Abrir mesmo assim. O botão aparece somente após a primeira tentativa de abertura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naast het bericht 'BookmarkBridge is geblokkeerd om uw Mac te beschermen' klikt u op Toch openen. De knop verschijnt pas na de eerste openingspoging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obok komunikatu „BookmarkBridge został zablokowany w celu ochrony Twojego Maca” kliknij Otwórz mimo to. Przycisk pojawia się dopiero po pierwszej próbie otwarcia."
          }
        }
      }
    },
    "manual.noFavoritesAreTransmittedOverTheNetwork": {
