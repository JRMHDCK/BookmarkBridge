    "help.configuration.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions are stored as secure credentials managed by macOS. BookmarkBridge does not upload your bookmarks and does not rely on any network services."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations sont stockées sous forme de références sécurisées gérées par macOS. BookmarkBridge ne téléverse pas vos favoris et ne dépend d’aucun service réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos se almacenan como credenciales seguras administradas por macOS. BookmarkBridge no carga sus favoritos y no depende de ningún servicio de red."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen werden als sichere Anmeldeinformationen gespeichert, die von macOS verwaltet werden. BookmarkBridge lädt Ihre Lesezeichen nicht hoch und ist nicht auf Netzwerkdienste angewiesen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le autorizzazioni vengono archiviate come credenziali sicure gestite da macOS. BookmarkBridge non carica i tuoi segnalibri e non si basa su alcun servizio di rete."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As permissões são armazenadas como credenciais seguras gerenciadas pelo macOS. BookmarkBridge não carrega seus favoritos e não depende de nenhum serviço de rede."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Machtigingen worden opgeslagen als veilige inloggegevens die worden beheerd door macOS. BookmarkBridge uploadt uw bladwijzers niet en is niet afhankelijk van netwerkdiensten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienia są przechowywane jako bezpieczne dane uwierzytelniające zarządzane przez system macOS. BookmarkBridge nie przesyła zakładek i nie korzysta z żadnych usług sieciowych."
          }
        }
      }
    },
