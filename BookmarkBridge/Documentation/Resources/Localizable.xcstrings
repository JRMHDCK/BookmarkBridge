    "browserClosure.authorizationSaveFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new authorization could not be saved. No active source was replaced."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle autorisation n'a pas pu être enregistrée. Aucune source active n'a été remplacée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la nueva autorización. No se reemplazó ninguna fuente activa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Autorisierung konnte nicht gespeichert werden. Es wurde keine aktive Quelle ersetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la nuova autorizzazione. Nessuna fonte attiva è stata sostituita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova autorização não pôde ser salva. Nenhuma fonte ativa foi substituída."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nieuwe autorisatie kon niet worden opgeslagen. Er is geen actieve bron vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać nowej autoryzacji. Żadne aktywne źródło nie zostało wymienione."
          }
        }
      }
    },
    "browserClosure.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the browsers was cancelled. No data was read or written."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture des navigateurs a été annulée. Aucune donnée n'a été lue ou écrite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló el cierre de los navegadores. No se leyeron ni escribieron datos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schließen des Browsers wurde abgebrochen. Es wurden keine Daten gelesen oder geschrieben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiusura dei browser è stata annullata. Nessun dato è stato letto o scritto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fechamento dos navegadores foi cancelado. Nenhum dado foi lido ou gravado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het sluiten van de browsers is geannuleerd. Er zijn geen gegevens gelezen of geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamykanie przeglądarek zostało anulowane. Żadne dane nie zostały odczytane ani zapisane."
          }
        }
      }
    },
