    "manual.openSystemSettingsThenPrivacySecurityScroll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings, then Privacy & Security. Scroll down to the Security section."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages Système, puis Confidentialité et sécurité. Descendez jusqu’à la section Sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Configuración del sistema, luego Privacidad y seguridad. Desplácese hacia abajo hasta la sección Seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie „Systemeinstellungen“ und dann „Datenschutz und Sicherheit“. Scrollen Sie nach unten zum Abschnitt Sicherheit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di sistema, quindi Privacy e sicurezza. Scorri verso il basso fino alla sezione Sicurezza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Configurações do sistema e depois Privacidade e segurança. Role para baixo até a seção Segurança."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Systeeminstellingen en vervolgens Privacy en beveiliging. Scroll omlaag naar het gedeelte Beveiliging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia systemu, a następnie Prywatność i bezpieczeństwo. Przewiń w dół do sekcji Bezpieczeństwo."
          }
        }
      }
    },
