    "help.troubleshooting.retry.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Sources from Home, verify that Safari and Chrome are allowed, then return to Sync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisez les sources depuis Accueil, vérifiez que Safari et Chrome sont autorisés, puis revenez dans Synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice Fuentes desde Inicio, verifique que Safari y Chrome estén permitidos y luego regrese a Sincronizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Quellen von zu Hause aus, stellen Sie sicher, dass Safari und Chrome zulässig sind, und kehren Sie dann zu „Synchronisieren“ zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna le fonti da Home, verifica che Safari e Chrome siano consentiti, quindi torna a Sincronizza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize as fontes em casa, verifique se o Safari e o Chrome são permitidos e retorne para sincronizar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vernieuw bronnen vanaf Home, controleer of Safari en Chrome zijn toegestaan en ga vervolgens terug naar Synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odśwież źródła z domu, sprawdź, czy Safari i Chrome są dozwolone, a następnie wróć do synchronizacji."
          }
        }
      }
    },
    "help.troubleshooting.retry.title": {
