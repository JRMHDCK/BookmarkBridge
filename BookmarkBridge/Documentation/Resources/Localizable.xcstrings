    "help.introduction.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge syncs Safari and Google Chrome bookmarks back and forth on your Mac. It always shows changes before applying them and keeps a restorable backup of the target browser before any writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge synchronise les favoris de Safari et de Google Chrome dans les deux sens sur votre Mac. Il montre toujours les changements avant de les appliquer et conserve une sauvegarde restaurable du navigateur cible avant toute écriture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge sincroniza los marcadores de Safari y Google Chrome en tu Mac. Siempre muestra los cambios antes de aplicarlos y mantiene una copia de seguridad restaurable del navegador de destino antes de escribir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge synchronisiert Safari- und Google Chrome-Lesezeichen auf Ihrem Mac hin und her. Änderungen werden immer angezeigt, bevor sie angewendet werden, und es wird vor dem Schreiben ein wiederherstellbares Backup des Zielbrowsers erstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge sincronizza i segnalibri di Safari e Google Chrome avanti e indietro sul tuo Mac. Mostra sempre le modifiche prima di applicarle e mantiene un backup ripristinabile del browser di destinazione prima di qualsiasi scrittura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge sincroniza os favoritos do Safari e do Google Chrome no seu Mac. Ele sempre mostra as alterações antes de aplicá-las e mantém um backup restaurável do navegador de destino antes de qualquer gravação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge synchroniseert Safari- en Google Chrome-bladwijzers heen en weer op uw Mac. Het toont altijd wijzigingen voordat ze worden toegepast en houdt een herstelbare back-up van de doelbrowser bij voordat er wordt geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge synchronizuje zakładki Safari i Google Chrome tam i z powrotem na komputerze Mac. Zawsze pokazuje zmiany przed ich zastosowaniem i przechowuje odtwarzalną kopię zapasową przeglądarki docelowej przed jakimkolwiek zapisem."
          }
        }
      }
    },
    "help.introduction.principles.backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection: A backup is created before modifying the target library, whether Safari or Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection : une sauvegarde est créée avant la modification de la bibliothèque cible, qu’il s’agisse de Safari ou de Chrome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección: se crea una copia de seguridad antes de modificar la biblioteca de destino, ya sea Safari o Chrome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schutz: Vor der Änderung der Zielbibliothek, egal ob Safari oder Chrome, wird ein Backup erstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Protezione: viene creato un backup prima di modificare la libreria di destinazione, sia Safari che Chrome."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteção: Um backup é criado antes de modificar a biblioteca de destino, seja Safari ou Chrome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveiliging: Er wordt een back-up gemaakt voordat de doelbibliotheek wordt gewijzigd, of het nu Safari of Chrome is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrona: przed modyfikacją biblioteki docelowej, niezależnie od tego, czy jest to Safari, czy Chrome, tworzona jest kopia zapasowa."
          }
        }
      }
    },
