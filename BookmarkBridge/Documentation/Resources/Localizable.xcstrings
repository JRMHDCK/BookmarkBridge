            "value": "Actualiza Inicio para leer las bibliotecas de Safari y Chrome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Startseite, um die Safari- und Chrome-Bibliotheken zu lesen."
          }
        },
        "it": {
