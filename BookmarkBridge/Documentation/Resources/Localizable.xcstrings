    "manual.sensSafariToChromeOrChromeTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b>: Safari to Chrome or Chrome to Safari choice which determines the source and target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b> : choix Safari vers Chrome ou Chrome vers Safari qui détermine la source et la cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b>: opción de Safari a Chrome o de Chrome a Safari que determina el origen y el destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b>: Auswahl von Safari zu Chrome oder Chrome zu Safari, die die Quelle und das Ziel bestimmt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b>: scelta da Safari a Chrome o da Chrome a Safari che determina l'origine e la destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b>: escolha Safari para Chrome ou Chrome para Safari que determina a origem e o destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sens</b>: Safari naar Chrome of Chrome naar Safari keuze die de bron en het doel bepaalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Czułość</b>: wybór z Safari do Chrome lub z Chrome do Safari, który określa źródło i cel."
