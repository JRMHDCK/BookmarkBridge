      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 erfordert macOS 26.5 oder höher. Die Anwendung funktioniert auf Apple Silicon- und Intel 64-Bit-Macs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 requires macOS 26.5 or later. The application works on Apple Silicon and Intel 64-bit Macs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 requiere macOS 26.5 o posterior. La aplicación funciona en Mac Apple Silicon e Intel de 64 bits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 nécessite macOS 26.5 ou une version ultérieure. L’application fonctionne sur les Mac Apple Silicon et Intel 64 bits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 richiede macOS 26.5 o successivo. L'applicazione funziona su Mac Apple Silicon e Intel a 64 bit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 vereist macOS 26.5 of hoger. De applicatie werkt op Apple Silicon en Intel 64-bit Macs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BookmarkBridge 0.9.2 wymaga systemu macOS 26.5 lub nowszego. Aplikacja działa na 64-bitowych komputerach Mac Apple Silicon i Intel."
