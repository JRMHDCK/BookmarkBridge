    "manual.backupRestorableCopyOfTheTargetLibrary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Backup</b>: restorable copy of the target library created before a write."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sauvegarde</b> : copie restaurable de la bibliothèque cible créée avant une écriture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Copia de seguridad</b>: copia restaurable de la biblioteca de destino creada antes de una escritura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sicherung</b>: wiederherstellbare Kopie der Zielbibliothek, die vor einem Schreibvorgang erstellt wurde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Backup</b>: copia ripristinabile della libreria di destinazione creata prima di una scrittura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Backup</b>: cópia restaurável da biblioteca de destino criada antes de uma gravação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Back-up</b>: herstelbare kopie van de doelbibliotheek die vóór het schrijven is gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Kopia zapasowa</b>: możliwa do przywrócenia kopia biblioteki docelowej utworzona przed zapisem."
          }
        }
      }
    },
