    "manual.dependingOnTheDirectionAndSelectionThe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depending on the direction and selection, the preview may suggest address creations, deletions, moves, renames and updates in the target browser. Nothing is applied until your confirmation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon le sens et la sélection, l’aperçu peut proposer des créations, suppressions, déplacements, renommages et mises à jour d’adresse dans le navigateur cible. Rien n’est appliqué avant votre confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependiendo de la dirección y la selección, la vista previa puede sugerir creaciones, eliminaciones, movimientos, cambios de nombre y actualizaciones de direcciones en el navegador de destino. No se aplica nada hasta su confirmación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängig von der Richtung und Auswahl kann die Vorschau das Erstellen, Löschen, Verschieben, Umbenennen und Aktualisieren von Adressen im Zielbrowser vorschlagen. Bis zu Ihrer Bestätigung wird nichts angewendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A seconda della direzione e della selezione, l'anteprima può suggerire creazioni di indirizzi, eliminazioni, spostamenti, ridenominazioni e aggiornamenti nel browser di destinazione. Non viene applicato nulla fino alla tua conferma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependendo da direção e da seleção, a visualização pode sugerir criações, exclusões, movimentações, renomeações e atualizações de endereços no navegador de destino. Nada é aplicado até a sua confirmação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhankelijk van de richting en selectie kan het voorbeeld het maken, verwijderen, verplaatsen, hernoemen en bijwerken van adressen in de doelbrowser voorstellen. Er wordt niets toegepast tot uw bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zależności od kierunku i wyboru podgląd może sugerować tworzenie, usuwanie, przenoszenie, zmianę nazwy i aktualizację adresu w przeglądarce docelowej. Dopóki nie potwierdzisz, nic nie jest stosowane."
          }
        }
      }
    },
