    "onboarding.overview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge reads your libraries, displays their status, and lets you explore folders before syncing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lit vos bibliothèques, affiche leur état et vous permet d’explorer les dossiers avant toute synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lee sus bibliotecas, muestra su estado y le permite explorar carpetas antes de sincronizarlas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge liest Ihre Bibliotheken, zeigt deren Status an und ermöglicht Ihnen das Durchsuchen von Ordnern vor der Synchronisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge legge le tue librerie, ne visualizza lo stato e ti consente di esplorare le cartelle prima della sincronizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lê suas bibliotecas, exibe seu status e permite explorar pastas antes de sincronizar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge leest uw bibliotheken, geeft hun status weer en laat u mappen verkennen voordat u gaat synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge odczytuje Twoje biblioteki, wyświetla ich stan i pozwala przeglądać foldery przed synchronizacją."
          }
        }
      }
    },
