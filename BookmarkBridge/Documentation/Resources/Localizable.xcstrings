    "manual.ifThisFailsBookmarkBridgeAbortsTheOperation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this fails, BookmarkBridge aborts the operation and keeps the existing bookmarks. Do not manually modify browser files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d’échec, BookmarkBridge interrompt l’opération et conserve les favoris existants. Ne modifiez pas manuellement les fichiers des navigateurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto falla, BookmarkBridge cancela la operación y conserva los marcadores existentes. No modifique manualmente los archivos del navegador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies fehlschlägt, bricht BookmarkBridge den Vorgang ab und behält die vorhandenen Lesezeichen bei. Ändern Sie Browserdateien nicht manuell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se fallisce, BookmarkBridge interrompe l'operazione e mantiene i segnalibri esistenti. Non modificare manualmente i file del browser."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isso falhar, o BookmarkBridge anula a operação e mantém os marcadores existentes. Não modifique manualmente os arquivos do navegador."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit mislukt, breekt BookmarkBridge de bewerking af en behoudt de bestaande bladwijzers. Wijzig browserbestanden niet handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to się nie powiedzie, BookmarkBridge przerywa operację i zachowuje istniejące zakładki. Nie modyfikuj ręcznie plików przeglądarki."
          }
        }
      }
    },
    "manual.inTheDashboardChooseAllowForSafari": {
      "extractionState": "manual",
      "localizations": {
        "en": {
