    "help.conflicts.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A conflict is a situation where BookmarkBridge cannot choose a safe action without additional information. Beta favors no writing rather than a risky automatic decision."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conflit désigne une situation où BookmarkBridge ne peut pas choisir une action sûre sans information supplémentaire. La bêta privilégie l’absence d’écriture plutôt qu’une décision automatique risquée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conflicto es una situación en la que BookmarkBridge no puede elegir una acción segura sin información adicional. Beta prefiere no escribir antes que tomar una decisión automática arriesgada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konflikt ist eine Situation, in der BookmarkBridge ohne zusätzliche Informationen keine sichere Aktion auswählen kann. Beta bevorzugt kein Schreiben statt einer riskanten automatischen Entscheidung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conflitto è una situazione in cui BookmarkBridge non può scegliere un'azione sicura senza informazioni aggiuntive. Beta preferisce non scrivere piuttosto che una rischiosa decisione automatica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um conflito é uma situação em que o BookmarkBridge não consegue escolher uma ação segura sem informações adicionais. Beta prefere não escrever, em vez de uma decisão automática arriscada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een conflict is een situatie waarin BookmarkBridge zonder aanvullende informatie geen veilige actie kan kiezen. Bèta geeft de voorkeur aan niet schrijven in plaats van een riskante automatische beslissing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikt to sytuacja, w której BookmarkBridge nie może wybrać bezpiecznej akcji bez dodatkowych informacji. Beta woli brak pisania niż ryzykowną, automatyczną decyzję."
          }
        }
      }
    },
    "help.conflicts.safety.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 does not resolve a conflict by silently deleting or overwriting a bookmark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 ne résout pas un conflit en supprimant ou en écrasant silencieusement un favori."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 no resuelve un conflicto eliminando o sobrescribiendo silenciosamente un marcador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 löst einen Konflikt nicht durch stillschweigendes Löschen oder Überschreiben eines Lesezeichens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 non risolve un conflitto eliminando o sovrascrivendo silenziosamente un segnalibro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 não resolve um conflito excluindo ou substituindo silenciosamente um marcador."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 lost een conflict niet op door stilletjes een bladwijzer te verwijderen of te overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 nie rozwiązuje konfliktu poprzez ciche usuwanie lub zastąpienie zakładki."
          }
        }
      }
    },
