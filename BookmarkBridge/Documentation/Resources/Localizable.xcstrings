    "error.synchronization.solution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave Safari and Chrome closed, refresh the preview and try again. Use Restore if the button is offered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez Safari et Chrome fermés, actualisez l’aperçu et réessayez. Utilisez Restaurer si le bouton est proposé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje Safari y Chrome cerrados, actualice la vista previa y vuelva a intentarlo. Utilice Restaurar si se ofrece el botón."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie Safari und Chrome geschlossen, aktualisieren Sie die Vorschau und versuchen Sie es erneut. Verwenden Sie Wiederherstellen, wenn die Schaltfläche angeboten wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia Safari e Chrome chiusi, aggiorna l'anteprima e riprova. Utilizzare Ripristina se il pulsante viene offerto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o Safari e o Chrome fechados, atualize a visualização e tente novamente. Use Restaurar se o botão for oferecido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Safari en Chrome gesloten, ververs het voorbeeld en probeer het opnieuw. Gebruik Herstellen als de knop wordt aangeboden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw przeglądarki Safari i Chrome zamknięte, odśwież podgląd i spróbuj ponownie. Użyj Przywróć, jeśli przycisk jest dostępny."
          }
        }
      }
    },
