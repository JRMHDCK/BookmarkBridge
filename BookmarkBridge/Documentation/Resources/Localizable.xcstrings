          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation a échoué après %ld opérations. Cause initiale : %@. La restauration automatique a échoué. %@ Fermez Safari et Chrome avant de réessayer."
