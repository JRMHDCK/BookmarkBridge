    "sync.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari and Chrome must be closed. An automatic backup will be created before any changes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari et Chrome doivent être fermés. Une sauvegarde automatique sera créée avant toute modification."
