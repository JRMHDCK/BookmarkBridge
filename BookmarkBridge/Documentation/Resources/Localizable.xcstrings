    "bugReport.email.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo,\\n\\nBeschreiben Sie kurz, was Sie unmittelbar vor dem Problem beobachtet haben:\\n\\n\\n---\\nBerichts-ID: %@\\nBookmarkBridge: %@ (Build %@)\\nmacOS: %@ — %@\\nRichtung: %@\\nSchritt: %@\\nFehler: %@ / %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello,\\n\\nBriefly describe what you observed just before the problem:\\n\\n\\n---\\nReport ID: %@\\nBookmarkBridge: %@ (build %@)\\nmacOS: %@ — %@\\nDirection: %@\\nStage: %@\\nError: %@ / %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola,\\n\\nDescribe brevemente lo que observaste justo antes del problema:\\n\\n\\n---\\nIdentificador del informe: %@\\nBookmarkBridge: %@ (compilación %@)\\nmacOS: %@ — %@\\nSentido: %@\\nEtapa: %@\\nError: %@ / %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour,\\n\\nDécrivez en une phrase ce que vous avez constaté juste avant le problème :\\n\\n\\n---\\nIdentifiant du rapport : %@\\nBookmarkBridge : %@ (build %@)\\nmacOS : %@ — %@\\nSens : %@\\nÉtape : %@\\nErreur : %@ / %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve,\\n\\nDescrivi brevemente ciò che hai osservato subito prima del problema:\\n\\n\\n---\\nID rapporto: %@\\nBookmarkBridge: %@ (build %@)\\nmacOS: %@ — %@\\nDirezione: %@\\nFase: %@\\nErrore: %@ / %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo,\\n\\nBeschrijf kort wat u vlak vóór het probleem hebt waargenomen:\\n\\n\\n---\\nRapport-ID: %@\\nBookmarkBridge: %@ (build %@)\\nmacOS: %@ — %@\\nRichting: %@\\nStap: %@\\nFout: %@ / %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień dobry,\\n\\nKrótko opisz, co zaobserwowano bezpośrednio przed problemem:\\n\\n\\n---\\nIdentyfikator raportu: %@\\nBookmarkBridge: %@ (kompilacja %@)\\nmacOS: %@ — %@\\nKierunek: %@\\nEtap: %@\\nBłąd: %@ / %@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
