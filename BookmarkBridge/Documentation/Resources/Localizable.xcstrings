            "state": "translated",
            "value": "Podgląd nie ładuje się"
          }
        }
      }
    },
    "help.troubleshooting.safe.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A failure before confirmation does not write anything. A failure after creating the backup retains it to allow restoration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un échec avant la confirmation n’écrit rien. Un échec après la création de la sauvegarde conserve celle-ci pour permettre une restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fallo antes de la confirmación no escribe nada. Un error después de crear la copia de seguridad la retiene para permitir la restauración."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler vor der Bestätigung schreibt nichts. Tritt nach der Erstellung des Backups ein Fehler auf, bleibt es erhalten, um eine Wiederherstellung zu ermöglichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fallimento prima della conferma non scrive nulla. Un errore dopo la creazione del backup lo conserva per consentire il ripristino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma falha antes da confirmação não escreve nada. Uma falha após a criação do backup o mantém para permitir a restauração."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een fout vóór bevestiging schrijft niets. Bij een fout na het maken van de back-up blijft deze behouden om herstel mogelijk te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaria przed potwierdzeniem nic nie pisze. Awaria po utworzeniu kopii zapasowej powoduje jej zachowanie, aby umożliwić przywrócenie."
          }
        }
      }
    },
