    "synchronization.direction.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Richtung manuell. Ohne dauerhaften Änderungsverlauf kann BookmarkBridge die neueste Quelle nicht zuverlässig automatisch bestimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the direction manually. Without a durable change history, BookmarkBridge cannot reliably determine the newest source automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija la dirección manualmente. Sin un historial de cambios persistente, BookmarkBridge no puede determinar de forma fiable la fuente más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le sens manuellement. Sans historique durable des modifications, BookmarkBridge ne peut pas déterminer automatiquement la source la plus récente de façon fiable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli manualmente la direzione. Senza una cronologia persistente, BookmarkBridge non può determinare automaticamente la fonte più recente in modo affidabile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de richting handmatig. Zonder blijvende wijzigingsgeschiedenis kan BookmarkBridge de nieuwste bron niet betrouwbaar automatisch bepalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kierunek ręcznie. Bez trwałej historii zmian BookmarkBridge nie może wiarygodnie automatycznie określić najnowszego źródła."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a direção manualmente. Sem um histórico persistente, o BookmarkBridge não pode determinar automaticamente a fonte mais recente com segurança."
          }
        }
      }
    },
