    "help.backups.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before any writing, BookmarkBridge creates a private, timestamped copy of the target library, Safari or Chrome. The backup is tied to the exact location that was changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant toute écriture, BookmarkBridge crée une copie privée et horodatée de la bibliothèque cible, Safari ou Chrome. La sauvegarde est liée à l’emplacement exact qui a été modifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de escribir, BookmarkBridge crea una copia privada con marca de tiempo de la biblioteca de destino, Safari o Chrome. La copia de seguridad está vinculada a la ubicación exacta que se cambió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Schreiben erstellt BookmarkBridge eine private, zeitgestempelte Kopie der Zielbibliothek, Safari oder Chrome. Die Sicherung ist an den genauen Speicherort gebunden, der geändert wurde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di qualsiasi scrittura, BookmarkBridge crea una copia privata con timestamp della libreria di destinazione, Safari o Chrome. Il backup è legato alla posizione esatta che è stata modificata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de qualquer escrita, o BookmarkBridge cria uma cópia privada com carimbo de data e hora da biblioteca de destino, Safari ou Chrome. O backup está vinculado ao local exato que foi alterado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat er wordt geschreven, maakt BookmarkBridge een privékopie met tijdstempel van de doelbibliotheek, Safari of Chrome. De back-up is gekoppeld aan de exacte locatie die is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed jakimkolwiek zapisem BookmarkBridge tworzy prywatną kopię biblioteki docelowej, Safari lub Chrome, ze znacznikiem czasu. Kopia zapasowa jest powiązana z dokładną lokalizacją, która została zmieniona."
          }
        }
      }
    },
    "help.backups.restore.close": {
      "extractionState": "manual",
      "localizations": {
