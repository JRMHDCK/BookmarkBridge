    "help.faq.safari.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The macOS sandbox prevents an app from opening your Safari library without an explicit selection. The permission remains local and can be requested again if the file is moved or if macOS revokes it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sandbox macOS interdit à une application d’ouvrir votre bibliothèque Safari sans sélection explicite. L’autorisation reste locale et peut être redemandée si le fichier est déplacé ou si macOS la révoque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona de pruebas de macOS impide que una aplicación abra su biblioteca de Safari sin una selección explícita. El permiso sigue siendo local y se puede solicitar nuevamente si se mueve el archivo o si macOS lo revoca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die macOS-Sandbox verhindert, dass eine App Ihre Safari-Bibliothek ohne explizite Auswahl öffnet. Die Berechtigung bleibt lokal und kann erneut angefordert werden, wenn die Datei verschoben wird oder macOS sie widerruft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sandbox di macOS impedisce a un'app di aprire la libreria Safari senza una selezione esplicita. Il permesso rimane locale e può essere richiesto nuovamente se il file viene spostato o se macOS lo revoca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sandbox do macOS impede que um aplicativo abra sua biblioteca do Safari sem uma seleção explícita. A permissão permanece local e pode ser solicitada novamente se o arquivo for movido ou se o macOS o revogar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De macOS-sandbox voorkomt dat een app uw Safari-bibliotheek opent zonder expliciete selectie. De toestemming blijft lokaal en kan opnieuw worden aangevraagd als het bestand wordt verplaatst of als macOS deze intrekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Piaskownica macOS uniemożliwia aplikacji otwarcie biblioteki Safari bez wyraźnego wyboru. Uprawnienie pozostaje lokalne i można o nie poprosić ponownie, jeśli plik zostanie przeniesiony lub jeśli macOS je unieważni."
          }
        }
      }
    },
    "help.faq.safari.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does Safari ask for permission?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi Safari demande-t-il une autorisation ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué Safari pide permiso?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum fragt Safari um Erlaubnis?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché Safari chiede l'autorizzazione?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que o Safari pede permissão?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom vraagt Safari om toestemming?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego Safari pyta o pozwolenie?"
          }
        }
      }
    },
    "help.faq.sync.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge reads both libraries, uses the chosen direction to determine the source and target, calculates a preview, waits for your confirmation, saves the target and then applies the displayed plan exactly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lit les deux bibliothèques, utilise le sens choisi pour déterminer la source et la cible, calcule un aperçu, attend votre confirmation, sauvegarde la cible puis applique exactement le plan affiché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lee ambas bibliotecas, utiliza la dirección elegida para determinar el origen y el destino, calcula una vista previa, espera su confirmación, guarda el destino y luego aplica exactamente el plan mostrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge liest beide Bibliotheken, ermittelt anhand der gewählten Richtung Quelle und Ziel, berechnet eine Vorschau, wartet auf Ihre Bestätigung, speichert das Ziel und wendet dann den angezeigten Plan exakt an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge legge entrambe le librerie, utilizza la direzione scelta per determinare l'origine e la destinazione, calcola un'anteprima, attende la tua conferma, salva la destinazione e quindi applica esattamente il piano visualizzato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lê ambas as bibliotecas, usa a direção escolhida para determinar a origem e o destino, calcula uma visualização, aguarda sua confirmação, salva o destino e então aplica exatamente o plano exibido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge leest beide bibliotheken, bepaalt in de gekozen richting de bron en het doel, berekent een voorbeeld, wacht op uw bevestiging, slaat het doel op en past vervolgens het weergegeven plan precies toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge czyta obie biblioteki, wykorzystuje wybrany kierunek do określenia źródła i celu, oblicza podgląd, czeka na Twoje potwierdzenie, zapisuje cel, a następnie dokładnie stosuje wyświetlony plan."
          }
        }
      }
    },
