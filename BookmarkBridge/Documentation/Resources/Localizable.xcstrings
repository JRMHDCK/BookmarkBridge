    "help.safari.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge reads Safari's local library to display its folders and favorites. It serves as a source in the Safari to Chrome direction and as a target in the Chrome to Safari direction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lit la bibliothèque locale de Safari pour afficher ses dossiers et ses favoris. Elle sert de source dans le sens Safari vers Chrome et de cible dans le sens Chrome vers Safari."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lee la biblioteca local de Safari para mostrar sus carpetas y favoritos. Sirve como fuente en la dirección de Safari a Chrome y como destino en la dirección de Chrome a Safari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge liest die lokale Bibliothek von Safari, um deren Ordner und Favoriten anzuzeigen. Es dient als Quelle in der Richtung von Safari nach Chrome und als Ziel in der Richtung von Chrome nach Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge legge la libreria locale di Safari per visualizzarne le cartelle e i preferiti. Serve come origine nella direzione da Safari a Chrome e come destinazione nella direzione da Chrome a Safari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lê a biblioteca local do Safari para exibir suas pastas e favoritos. Ele serve como fonte na direção Safari para Chrome e como alvo na direção Chrome para Safari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge leest de lokale bibliotheek van Safari om de mappen en favorieten weer te geven. Het dient als bron in de richting van Safari naar Chrome en als doel in de richting van Chrome naar Safari."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge odczytuje lokalną bibliotekę Safari, aby wyświetlić jej foldery i ulubione. Służy jako źródło w kierunku z Safari do Chrome i jako cel w kierunku z Chrome do Safari."
          }
        }
      }
    },
    "help.safari.writing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Chrome to Safari direction, BookmarkBridge applies the operations displayed in the preview to Safari. A backup of the Safari library is created before writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le sens Chrome vers Safari, BookmarkBridge applique à Safari les opérations affichées dans l’aperçu. Une sauvegarde de la bibliothèque Safari est créée avant l’écriture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la dirección de Chrome a Safari, BookmarkBridge aplica las operaciones que se muestran en la vista previa a Safari. Se crea una copia de seguridad de la biblioteca de Safari antes de escribir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Richtung von Chrome zu Safari wendet BookmarkBridge die in der Vorschau angezeigten Vorgänge auf Safari an. Vor dem Schreiben wird ein Backup der Safari-Bibliothek erstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella direzione da Chrome a Safari, BookmarkBridge applica le operazioni visualizzate nell'anteprima a Safari. Prima della scrittura viene creato un backup della libreria Safari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na direção do Chrome para Safari, o BookmarkBridge aplica as operações exibidas na visualização ao Safari. Um backup da biblioteca Safari é criado antes da gravação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de richting Chrome naar Safari past BookmarkBridge de bewerkingen toe die in het voorbeeld worden weergegeven op Safari. Voordat u gaat schrijven, wordt er een back-up van de Safari-bibliotheek gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kierunku Chrome do Safari BookmarkBridge stosuje operacje wyświetlane w podglądzie do Safari. Przed zapisem tworzona jest kopia zapasowa biblioteki Safari."
          }
        }
      }
    },
