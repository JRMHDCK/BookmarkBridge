    "error.multipleStores.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two bookmark stores were detected (Bookmarks + AccountBookmarks). No safe choice can be made."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux magasins de favoris ont été détectés (Bookmarks + AccountBookmarks). Aucun choix sûr ne peut être fait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectaron dos tiendas de marcadores (Marcadores + Marcadores de cuenta). No se puede hacer ninguna elección segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
