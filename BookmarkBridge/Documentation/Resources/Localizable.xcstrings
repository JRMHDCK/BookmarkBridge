    "manual.reloadSafariAndChromeFromTheDashboard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Safari and Chrome from the dashboard. Correct the reported permissions, then rerun the comparison."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargez Safari et Chrome depuis le tableau de bord. Corrigez les autorisations signalées, puis relancez la comparaison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a cargar Safari y Chrome desde el panel. Corrija los permisos informados y luego vuelva a ejecutar la comparación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie Safari und Chrome über das Dashboard neu. Korrigieren Sie die gemeldeten Berechtigungen und führen Sie dann den Vergleich erneut durch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica Safari e Chrome dalla dashboard. Correggere le autorizzazioni segnalate, quindi eseguire nuovamente il confronto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarregue o Safari e o Chrome no painel. Corrija as permissões relatadas e execute novamente a comparação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad Safari en Chrome opnieuw vanaf het dashboard. Corrigeer de gerapporteerde machtigingen en voer de vergelijking vervolgens opnieuw uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załaduj ponownie Safari i Chrome z pulpitu nawigacyjnego. Popraw zgłoszone uprawnienia, a następnie ponownie uruchom porównanie."
          }
        }
      }
    },
