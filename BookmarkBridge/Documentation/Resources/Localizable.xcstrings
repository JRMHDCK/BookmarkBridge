    "help.chrome.authorization.profile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Sync, check the name of the selected Chrome profile, whether source or target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Synchronisation, vérifiez le nom du profil Chrome sélectionné, qu’il soit source ou cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Sincronización, verifique el nombre del perfil de Chrome seleccionado, ya sea de origen o de destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie in Sync den Namen des ausgewählten Chrome-Profils, egal ob Quelle oder Ziel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Sync, controlla il nome del profilo Chrome selezionato, sia di origine che di destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Sincronização, verifique o nome do perfil do Chrome selecionado, seja de origem ou de destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer in Sync de naam van het geselecteerde Chrome-profiel, of het nu bron of doel is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Sync sprawdź nazwę wybranego profilu Chrome, źródłowego lub docelowego."
          }
        }
      }
    },
