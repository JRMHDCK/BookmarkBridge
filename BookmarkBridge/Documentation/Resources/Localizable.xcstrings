    "help.chrome.closed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari and Chrome must be closed while syncing and restoring. This precaution prevents browsers and BookmarkBridge from modifying bookmarks at the same time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari et Chrome doivent être fermés pendant la synchronisation et la restauration. Cette précaution évite que les navigateurs et BookmarkBridge modifient les favoris en même temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari y Chrome deben estar cerrados durante la sincronización y restauración. Esta precaución evita que los navegadores y BookmarkBridge modifiquen los marcadores al mismo tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari und Chrome müssen während der Synchronisierung und Wiederherstellung geschlossen sein. Diese Vorsichtsmaßnahme verhindert, dass Browser und BookmarkBridge gleichzeitig Lesezeichen ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari e Chrome devono essere chiusi durante la sincronizzazione e il ripristino. Questa precauzione impedisce ai browser e a BookmarkBridge di modificare i segnalibri contemporaneamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari e Chrome devem ser fechados durante a sincronização e restauração. Esta precaução evita que os navegadores e o BookmarkBridge modifiquem os favoritos ao mesmo tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari en Chrome moeten gesloten zijn tijdens het synchroniseren en herstellen. Deze voorzorgsmaatregel voorkomt dat browsers en BookmarkBridge tegelijkertijd bladwijzers wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas synchronizacji i przywracania przeglądarki Safari i Chrome muszą być zamknięte. To zabezpieczenie uniemożliwia przeglądarce i BookmarkBridge jednoczesne modyfikowanie zakładek."
          }
        }
      }
    },
    "help.chrome.closed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Safari and Chrome before writing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez Safari et Chrome avant une écriture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Safari y Chrome antes de escribir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie Safari und Chrome, bevor Sie schreiben"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Safari e Chrome prima di scrivere"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o Safari e o Chrome antes de escrever"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Safari en Chrome voordat u gaat schrijven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed rozpoczęciem pisania zamknij Safari i Chrome"
          }
        }
      }
    },
    "help.chrome.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome can contain multiple profiles. BookmarkBridge discovers them in the Chrome folder you explicitly selected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome peut contenir plusieurs profils. BookmarkBridge les découvre dans le dossier Chrome que vous avez explicitement sélectionné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome puede contener varios perfiles. BookmarkBridge los descubre en la carpeta de Chrome que seleccionó explícitamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome kann mehrere Profile enthalten. BookmarkBridge erkennt sie im Chrome-Ordner, den Sie explizit ausgewählt haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome può contenere più profili. BookmarkBridge li rileva nella cartella Chrome che hai esplicitamente selezionato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Chrome pode conter vários perfis. BookmarkBridge os descobre na pasta do Chrome que você selecionou explicitamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome kan meerdere profielen bevatten. BookmarkBridge ontdekt ze in de Chrome-map die u expliciet hebt geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome może zawierać wiele profili. BookmarkBridge odkrywa je w wyraźnie wybranym folderze Chrome."
          }
        }
      }
    },
    "help.configuration.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge uses the recommended security settings. Configuration mainly consists of selecting the Safari and Chrome locations that macOS allows the application."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge utilise les réglages de sécurité recommandés. La configuration consiste principalement à sélectionner les emplacements Safari et Chrome que macOS autorise à l’application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge utiliza la configuración de seguridad recomendada. La configuración consiste principalmente en seleccionar las ubicaciones de Safari y Chrome que macOS permite a la aplicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge verwendet die empfohlenen Sicherheitseinstellungen. Die Konfiguration besteht hauptsächlich aus der Auswahl der Safari- und Chrome-Speicherorte, die macOS für die Anwendung zulässt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge utilizza le impostazioni di sicurezza consigliate. La configurazione consiste principalmente nel selezionare le posizioni Safari e Chrome consentite da macOS per l'applicazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge usa as configurações de segurança recomendadas. A configuração consiste principalmente em selecionar os locais do Safari e Chrome onde o macOS permite o aplicativo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge gebruikt de aanbevolen beveiligingsinstellingen. Configuratie bestaat voornamelijk uit het selecteren van de Safari- en Chrome-locaties die macOS de applicatie toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge korzysta z zalecanych ustawień zabezpieczeń. Konfiguracja polega głównie na wybraniu lokalizacji Safari i Chrome, w których macOS umożliwia aplikację."
          }
        }
      }
    },
    "help.configuration.permission.chrome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then choose the Chrome folder, then the desired local profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ensuite le dossier Chrome, puis le profil local voulu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego elija la carpeta Chrome y luego el perfil local deseado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie dann den Chrome-Ordner und dann das gewünschte lokale Profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quindi la cartella Chrome, quindi il profilo locale desiderato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, escolha a pasta do Chrome e depois o perfil local desejado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies vervolgens de Chrome-map en vervolgens het gewenste lokale profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie wybierz folder Chrome, a następnie żądany profil lokalny."
          }
        }
      }
    },
    "help.configuration.permission.safari": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Home, choose Safari Favorites when the Permissions card suggests it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Accueil, choisissez les favoris Safari lorsque la carte Autorisations le propose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Inicio, elija Favoritos de Safari cuando la tarjeta de Permisos lo sugiera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie auf der Startseite „Safari-Favoriten“ aus, wenn die Karte „Berechtigungen“ dies vorschlägt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Home, scegli Preferiti di Safari quando lo suggerisce la scheda Autorizzazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na página inicial, escolha Favoritos do Safari quando o cartão Permissões sugerir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies in Home Safari-favorieten wanneer de kaart Toestemmingen dit voorstelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Strona główna wybierz Ulubione Safari, gdy sugeruje to karta Uprawnienia."
          }
        }
      }
    },
    "help.configuration.permission.verify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that both sources appear as allowed before opening Sync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que les deux sources apparaissent comme autorisées avant d’ouvrir Synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique que ambas fuentes aparezcan según lo permitido antes de abrir Sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass beide Quellen als zulässig angezeigt werden, bevor Sie Sync öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificare che entrambe le origini siano visualizzate come consentite prima di aprire la sincronizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se ambas as fontes aparecem como permitidas antes de abrir o Sync."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of beide bronnen verschijnen zoals toegestaan voordat u Sync opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed otwarciem synchronizacji sprawdź, czy oba źródła są wyświetlane jako dozwolone."
          }
        }
      }
    },
