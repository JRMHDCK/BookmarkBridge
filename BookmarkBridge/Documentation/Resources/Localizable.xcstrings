          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli di nuovo Consenti dalla dashboard, quindi seleziona la stessa libreria. Questa operazione non modifica nessun preferito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Permitir novamente no painel e selecione a mesma biblioteca. Esta operação não modifica nenhum favorito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies opnieuw Toestaan op het dashboard en selecteer vervolgens dezelfde bibliotheek. Met deze handeling worden geen favorieten gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ponownie opcję Zezwalaj na panelu kontrolnym, a następnie wybierz tę samą bibliotekę. Ta operacja nie modyfikuje żadnych ulubionych."
          }
        }
      }
    },
