    "help.faq.restore.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Safari and Chrome, open Sync, and use Restore when the button is available. The backup corresponds to the previously modified Safari library or Chrome profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez Safari et Chrome, ouvrez Synchronisation et utilisez Restaurer lorsque le bouton est disponible. La sauvegarde correspond à la bibliothèque Safari ou au profil Chrome précédemment modifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre Safari y Chrome, abra Sincronizar y use Restaurar cuando el botón esté disponible. La copia de seguridad corresponde a la biblioteca de Safari o al perfil de Chrome previamente modificado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie Safari und Chrome, öffnen Sie die Synchronisierung und verwenden Sie „Wiederherstellen“, wenn die Schaltfläche verfügbar ist. Das Backup entspricht der zuvor geänderten Safari-Bibliothek oder dem Chrome-Profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Safari e Chrome, apri Sincronizza e utilizza Ripristina quando il pulsante è disponibile. Il backup corrisponde alla libreria Safari o al profilo Chrome precedentemente modificato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o Safari e o Chrome, abra o Sync e use Restaurar quando o botão estiver disponível. O backup corresponde à biblioteca Safari ou perfil do Chrome modificado anteriormente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Safari en Chrome, open Sync en gebruik Herstellen wanneer de knop beschikbaar is. De back-up komt overeen met de eerder gewijzigde Safari-bibliotheek of Chrome-profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij Safari i Chrome, otwórz Synchronizuj i użyj Przywróć, gdy przycisk jest dostępny. Kopia zapasowa odpowiada wcześniej zmodyfikowanej bibliotece Safari lub profilowi ​​Chrome."
          }
        }
      }
    },
