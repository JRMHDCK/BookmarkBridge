        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari e Chrome devem estar fechados. Um backup automático será criado antes de qualquer alteração."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
