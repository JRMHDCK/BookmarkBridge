    "manual.synchronizationFollowsTheSameSecurePathIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization follows the same secure path in both directions: select, view, then confirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation suit le même parcours sécurisé dans les deux sens : sélectionner, apercevoir, puis confirmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización sigue el mismo camino seguro en ambas direcciones: seleccionar, ver y luego confirmar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung folgt in beiden Richtungen demselben sicheren Pfad: Auswählen, Anzeigen und dann Bestätigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione segue lo stesso percorso sicuro in entrambe le direzioni: seleziona, visualizza, quindi conferma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização segue o mesmo caminho seguro em ambas as direções: selecione, visualize e confirme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De synchronisatie volgt hetzelfde veilige pad in beide richtingen: selecteren, bekijken en vervolgens bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja odbywa się tą samą bezpieczną ścieżką w obu kierunkach: wybierz, wyświetl, a następnie potwierdź."
          }
        }
      }
    },
