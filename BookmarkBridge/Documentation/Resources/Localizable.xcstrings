    "manual.eachProfileMaintainsItsOwnLibrarySynchronization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile maintains its own library. Synchronization uses the selected local profile as source or target. A profile that simultaneously contains active local storage and account storage remains read-only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil conserve sa propre bibliothèque. La synchronisation utilise le profil local sélectionné comme source ou comme cible. Un profil contenant simultanément un stockage local et un stockage de compte actifs reste en lecture seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil mantiene su propia biblioteca. La sincronización utiliza el perfil local seleccionado como origen o destino. Un perfil que contiene simultáneamente almacenamiento local activo y almacenamiento de cuenta sigue siendo de solo lectura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil verwaltet seine eigene Bibliothek. Die Synchronisierung verwendet das ausgewählte lokale Profil als Quelle oder Ziel. Ein Profil, das gleichzeitig aktiven lokalen Speicher und Kontospeicher enthält, bleibt schreibgeschützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni profilo mantiene la propria libreria. La sincronizzazione utilizza il profilo locale selezionato come origine o destinazione. Un profilo che contiene contemporaneamente spazio di archiviazione locale attivo e spazio di archiviazione dell'account rimane di sola lettura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil mantém sua própria biblioteca. A sincronização usa o perfil local selecionado como origem ou destino. Um perfil que contém simultaneamente armazenamento local ativo e armazenamento de conta permanece somente leitura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk profiel onderhoudt zijn eigen bibliotheek. Bij synchronisatie wordt het geselecteerde lokale profiel als bron of doel gebruikt. Een profiel dat tegelijkertijd actieve lokale opslag en accountopslag bevat, blijft alleen-lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil utrzymuje własną bibliotekę. Synchronizacja wykorzystuje wybrany profil lokalny jako źródło lub cel. Profil, który jednocześnie zawiera aktywną pamięć lokalną i pamięć konta, pozostaje tylko do odczytu."
          }
        }
      }
    },
