    "help.glossary.securityScope.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistent reference that allows a sandboxed application to reopen a user-chosen location."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Référence persistante qui permet à une application sandboxée de rouvrir un emplacement choisi par l’utilisateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencia persistente que permite que una aplicación protegida vuelva a abrir una ubicación elegida por el usuario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanente Referenz, die es einer Sandbox-Anwendung ermöglicht, einen vom Benutzer ausgewählten Speicherort erneut zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riferimento persistente che consente a un'applicazione sandbox di riaprire una posizione scelta dall'utente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Referência persistente que permite que um aplicativo em área restrita reabra um local escolhido pelo usuário."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistente referentie waarmee een toepassing in een sandbox een door de gebruiker gekozen locatie opnieuw kan openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwałe odniesienie, które umożliwia aplikacji działającej w trybie piaskownicy ponowne otwarcie lokalizacji wybranej przez użytkownika."
          }
        }
      }
    },
