    "onboarding.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No BookmarkBridge accounts or cloud services are used. Bookmarks are processed locally in the macOS sandbox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ni service cloud BookmarkBridge n’est utilisé. Les favoris sont traités localement dans le sandbox macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se utilizan cuentas BookmarkBridge ni servicios en la nube. Los marcadores se procesan localmente en el entorno limitado de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine BookmarkBridge-Konten oder Cloud-Dienste verwendet. Lesezeichen werden lokal in der macOS-Sandbox verarbeitet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vengono utilizzati account BookmarkBridge o servizi cloud. I segnalibri vengono elaborati localmente nella sandbox di macOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta BookmarkBridge ou serviços em nuvem são usados. Os marcadores são processados ​​localmente na sandbox do macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden geen BookmarkBridge-accounts of clouddiensten gebruikt. Bladwijzers worden lokaal verwerkt in de macOS-sandbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie są używane żadne konta BookmarkBridge ani usługi w chmurze. Zakładki są przetwarzane lokalnie w piaskownicy macOS."
          }
        }
      }
    },
