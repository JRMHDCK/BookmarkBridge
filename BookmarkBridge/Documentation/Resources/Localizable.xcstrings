    "help.faq.chromeEmpty.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the selected profile, then refresh Home. A different profile, account storage or an authorization that has become invalid can explain the absence of favorites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le profil sélectionné, puis actualisez Accueil. Un profil différent, un stockage de compte ou une autorisation devenue invalide peut expliquer l’absence de favoris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise el perfil seleccionado y luego actualice Inicio. Un perfil diferente, el almacenamiento de la cuenta o una autorización que ha dejado de ser válida pueden explicar la ausencia de favoritos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie das ausgewählte Profil und aktualisieren Sie dann die Startseite. Ein anderes Profil, ein anderer Kontospeicher oder eine ungültig gewordene Autorisierung können das Fehlen von Favoriten erklären."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi il profilo selezionato, quindi aggiorna Home. Un profilo diverso, la memorizzazione dell'account o un'autorizzazione divenuta non valida possono spiegare l'assenza di preferiti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise o perfil selecionado e atualize a página inicial. Um perfil diferente, o armazenamento da conta ou uma autorização que se tornou inválida podem explicar a ausência de favoritos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het geselecteerde profiel en vernieuw vervolgens Home. Een ander profiel, accountopslag of een ongeldig geworden autorisatie kunnen het ontbreken van favorieten verklaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj wybrany profil, a następnie odśwież stronę główną. Inny profil, miejsce na koncie lub nieważna autoryzacja mogą wyjaśniać brak ulubionych."
          }
        }
      }
    },
