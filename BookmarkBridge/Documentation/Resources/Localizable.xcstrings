    "manual.yesEachSyncUsesASpecificLocal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Each sync uses a specific local Chrome profile as the source or target. Choose its name, then refine the selection folder by folder and favorite by favorite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. Chaque synchronisation utilise un profil Chrome local précis comme source ou cible. Choisissez son nom, puis affinez la sélection dossier par dossier et favori par favori."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. Cada sincronización utiliza un perfil local específico de Chrome como origen o destino. Elija su nombre, luego refine la selección carpeta por carpeta y favorito por favorito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Bei jeder Synchronisierung wird ein bestimmtes lokales Chrome-Profil als Quelle oder Ziel verwendet. Wählen Sie den Namen und verfeinern Sie dann die Auswahl Ordner für Ordner und Favorit für Favorit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì. Ogni sincronizzazione utilizza un profilo Chrome locale specifico come origine o destinazione. Scegline il nome, quindi affina la selezione cartella per cartella e preferito per preferito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim. Cada sincronização usa um perfil local específico do Chrome como origem ou destino. Escolha seu nome e refine a seleção pasta por pasta e favorito por favorito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Elke synchronisatie gebruikt een specifiek lokaal Chrome-profiel als bron of doel. Kies de naam ervan en verfijn vervolgens de selectiemap per map en favoriet per favoriet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Każda synchronizacja wykorzystuje określony lokalny profil Chrome jako źródło lub cel. Wybierz jego nazwę, a następnie zawęź wybór folderu według folderu i ulubionego według ulubionego."
          }
        }
      }
    },
