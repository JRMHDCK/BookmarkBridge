    "error.restore.cause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari or Chrome is open, the permission has changed, or the backup is no longer accessible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ou Chrome est ouvert, l’autorisation a changé ou la sauvegarde n’est plus accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari o Chrome están abiertos, el permiso ha cambiado o ya no se puede acceder a la copia de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari oder Chrome ist geöffnet, die Berechtigung hat sich geändert oder auf das Backup kann nicht mehr zugegriffen werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari o Chrome sono aperti, l'autorizzazione è cambiata o il backup non è più accessibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Safari ou Chrome está aberto, a permissão foi alterada ou o backup não está mais acessível."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari of Chrome is geopend, de toestemming is gewijzigd of de back-up is niet langer toegankelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądarka Safari lub Chrome jest otwarta, uprawnienia uległy zmianie lub kopia zapasowa nie jest już dostępna."
          }
        }
      }
    },
    "error.restore.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not overwrite the current target library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n’a pas pu remplacer la bibliothèque cible actuelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad no pudo sobrescribir la biblioteca de destino actual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung konnte die aktuelle Zielbibliothek nicht überschreiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup non è riuscito a sovrascrivere la libreria di destinazione corrente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup não pôde substituir a biblioteca de destino atual."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De back-up kon de huidige doelbibliotheek niet overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa nie mogła zastąpić bieżącej biblioteki docelowej."
          }
        }
      }
    },
    "error.restore.solution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Safari and Chrome, reauthorize the affected library if necessary, and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez Safari et Chrome, autorisez de nouveau la bibliothèque concernée si nécessaire, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre Safari y Chrome, vuelva a autorizar la biblioteca afectada si es necesario y vuelva a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie Safari und Chrome, autorisieren Sie ggf. die betroffene Bibliothek erneut und versuchen Sie es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Safari e Chrome, autorizza nuovamente la libreria interessata se necessario e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o Safari e o Chrome, autorize novamente a biblioteca afetada, se necessário, e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Safari en Chrome, autoriseer indien nodig de betreffende bibliotheek opnieuw en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij przeglądarki Safari i Chrome, w razie potrzeby ponownie autoryzuj bibliotekę, której dotyczy problem, i spróbuj ponownie."
          }
        }
      }
    },
