    "onboarding.firstSync.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the sources, open Sync, choose the direction, check the preview, close Safari and Chrome and confirm. A backup of the target will be created automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisez les sources, ouvrez Synchronisation, choisissez le sens, vérifiez l’aperçu, fermez Safari et Chrome puis confirmez. Une sauvegarde de la cible sera créée automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice las fuentes, abra Sincronización, elija la dirección, verifique la vista previa, cierre Safari y Chrome y confirme. Se creará automáticamente una copia de seguridad del objetivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Quellen, öffnen Sie Sync, wählen Sie die Richtung, überprüfen Sie die Vorschau, schließen Sie Safari und Chrome und bestätigen Sie. Es wird automatisch ein Backup des Ziels erstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna le fonti, apri Sync, scegli la direzione, controlla l'anteprima, chiudi Safari e Chrome e conferma. Verrà creato automaticamente un backup della destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize as fontes, abra o Sync, escolha a direção, verifique a visualização, feche o Safari e o Chrome e confirme. Um backup do destino será criado automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ververs de bronnen, open Sync, kies de richting, controleer het voorbeeld, sluit Safari en Chrome en bevestig. Er wordt automatisch een back-up van het doel gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odśwież źródła, otwórz Synchronizację, wybierz kierunek, sprawdź podgląd, zamknij Safari i Chrome i potwierdź. Kopia zapasowa celu zostanie utworzona automatycznie."
          }
        }
      }
    },
