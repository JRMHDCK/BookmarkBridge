    "manual.bothDirectionsUseTheSameSecurePipeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both directions use the same secure pipeline: preview, confirmation, backup, transaction, commit, and failback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux sens utilisent le même pipeline sécurisé : aperçu, confirmation, sauvegarde, transaction, validation et restauration en cas d’échec."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas direcciones utilizan el mismo canal seguro: vista previa, confirmación, copia de seguridad, transacción, confirmación y conmutación por recuperación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Richtungen verwenden dieselbe sichere Pipeline: Vorschau, Bestätigung, Sicherung, Transaktion, Commit und Failback."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le direzioni utilizzano la stessa pipeline sicura: anteprima, conferma, backup, transazione, commit e failback."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas as direções usam o mesmo pipeline seguro: visualização, confirmação, backup, transação, confirmação e failback."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide richtingen gebruiken dezelfde beveiligde pijplijn: preview, bevestiging, back-up, transactie, commit en failback."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obydwa kierunki korzystają z tego samego bezpiecznego potoku: podgląd, potwierdzenie, kopia zapasowa, transakcja, zatwierdzenie i powrót po awarii."
          }
        }
      }
    },
