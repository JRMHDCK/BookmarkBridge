            "value": "Przywróć kopię zapasową"
          }
        }
      }
    },
    "help.backups.restore.verify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for confirmation, then open the restored browser to check your bookmarks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la confirmation, puis ouvrez le navigateur restauré pour vérifier vos favoris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere la confirmación, luego abra el navegador restaurado para verificar sus favoritos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie auf die Bestätigung und öffnen Sie dann den wiederhergestellten Browser, um Ihre Lesezeichen zu überprüfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi la conferma, quindi apri il browser ripristinato per controllare i tuoi segnalibri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a confirmação e abra o navegador restaurado para verificar seus favoritos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op bevestiging en open vervolgens de herstelde browser om uw bladwijzers te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na potwierdzenie, a następnie otwórz przywróconą przeglądarkę, aby sprawdzić zakładki."
          }
        }
      }
    },
    "help.backups.scope.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup can only restore the Safari library or Chrome profile it came from. This check prevents cross-restore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde ne peut restaurer que la bibliothèque Safari ou le profil Chrome dont elle provient. Cette vérification empêche une restauration croisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad sólo puede restaurar la biblioteca de Safari o el perfil de Chrome del que procede. Esta verificación evita la restauración cruzada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Backup kann nur die Safari-Bibliothek oder das Chrome-Profil wiederherstellen, aus dem es stammt. Diese Prüfung verhindert eine Cross-Restore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un backup può ripristinare solo la libreria Safari o il profilo Chrome da cui proviene. Questo controllo impedisce il ripristino incrociato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup só pode restaurar a biblioteca do Safari ou o perfil do Chrome de onde veio. Essa verificação evita a restauração cruzada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een back-up kan alleen de Safari-bibliotheek of het Chrome-profiel herstellen waar deze vandaan komt. Deze controle voorkomt kruisherstel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa może przywrócić tylko bibliotekę Safari lub profil Chrome, z której pochodzi. To sprawdzenie zapobiega przywracaniu krzyżowemu."
          }
        }
      }
    },
    "help.backups.scope.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Targeted restoration"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauration ciblée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauración dirigida"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezielte Sanierung"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauro mirato"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauração direcionada"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerichte restauratie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukierunkowana renowacja"
          }
        }
      }
    },
    "help.callout.bidirectional.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose Safari to Chrome or Chrome to Safari. Only the target browser is modified, in accordance with the previewed plan and after creating its backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous choisissez Safari vers Chrome ou Chrome vers Safari. Seul le navigateur cible est modifié, conformément au plan prévisualisé et après création de sa sauvegarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliges Safari a Chrome o Chrome a Safari. Sólo se modifica el navegador de destino, de acuerdo con el plan previo y después de crear su copia de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wählen Safari zu Chrome oder Chrome zu Safari. Lediglich der Zielbrowser wird gemäß dem in der Vorschau angezeigten Plan und nach der Erstellung seines Backups geändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Safari su Chrome o Chrome su Safari. Viene modificato solo il browser di destinazione, secondo il piano previsto e dopo averne creato il backup."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escolhe Safari para Chrome ou Chrome para Safari. Apenas o navegador alvo é modificado, de acordo com o plano pré-visualizado e após a criação do seu backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kiest voor Safari naar Chrome of Chrome naar Safari. Alleen de doelbrowser wordt gewijzigd, in overeenstemming met het voorbeeldplan en na het maken van de back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierasz Safari do Chrome lub Chrome do Safari. Modyfikowana jest tylko docelowa przeglądarka, zgodnie z podglądanym planem i po utworzeniu jej kopii zapasowej."
          }
        }
      }
    },
    "help.callout.bidirectional.title": {
      "extractionState": "manual",
      "localizations": {
