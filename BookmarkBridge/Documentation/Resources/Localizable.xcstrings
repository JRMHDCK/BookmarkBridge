    "manual.grantSafariAndChromeAccessSeparatelyWhen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Safari and Chrome access separately when macOS requests them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez séparément les accès Safari et Chrome lorsque macOS les demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acceso a Safari y Chrome por separado cuando macOS los solicite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewähren Sie Safari- und Chrome-Zugriff separat, wenn macOS dies anfordert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'accesso a Safari e Chrome separatamente quando macOS lo richiede."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso ao Safari e ao Chrome separadamente quando o macOS os solicitar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen Safari en Chrome afzonderlijk toegang als macOS daarom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj dostęp Safari i Chrome oddzielnie, gdy macOS o to poprosi."
          }
        }
      }
    },
