    "help.installation.step.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app, then confirm opening it if macOS asks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’application, puis confirmez son ouverture si macOS le demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra la aplicación, luego confirme abrirla si macOS lo solicita."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die App und bestätigen Sie das Öffnen, wenn macOS Sie dazu auffordert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app, quindi conferma l'apertura se macOS lo richiede."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o aplicativo e confirme a abertura se o macOS solicitar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app en bevestig het openen als macOS daarom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz aplikację, a następnie potwierdź jej otwarcie, jeśli macOS zapyta."
          }
        }
      }
    },
    "help.installation.step.permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the welcome wizard. Safari and Chrome access are requested separately and remain under your control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez l’assistant de bienvenue. Les accès Safari et Chrome sont demandés séparément et restent sous votre contrôle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga el asistente de bienvenida. El acceso a Safari y Chrome se solicita por separado y permanece bajo su control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen Sie dem Willkommensassistenten. Der Safari- und Chrome-Zugriff wird separat beantragt und bleibt unter Ihrer Kontrolle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la procedura guidata di benvenuto. L'accesso a Safari e Chrome sono richiesti separatamente e rimangono sotto il tuo controllo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga o assistente de boas-vindas. O acesso ao Safari e ao Chrome é solicitado separadamente e permanece sob seu controle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de welkomstwizard. Safari- en Chrome-toegang worden afzonderlijk aangevraagd en blijven onder uw controle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postępuj zgodnie z kreatorem powitalnym. Dostęp do Safari i Chrome jest wymagany osobno i pozostaje pod Twoją kontrolą."
          }
        }
      }
    },
    "help.installation.steps.title": {
