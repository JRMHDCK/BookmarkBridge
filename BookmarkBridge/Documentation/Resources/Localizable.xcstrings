    "onboarding.chrome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the Chrome folder to discover your profiles. The chosen local profile can serve as a synchronization source or target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le dossier Chrome pour découvrir vos profils. Le profil local choisi pourra servir de source ou de cible de synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione la carpeta Chrome para descubrir sus perfiles. El perfil local elegido puede servir como origen o destino de sincronización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Chrome-Ordner aus, um Ihre Profile zu entdecken. Das gewählte lokale Profil kann als Synchronisationsquelle oder -ziel dienen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona la cartella Chrome per scoprire i tuoi profili. Il profilo locale scelto può fungere da origine o destinazione della sincronizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione a pasta do Chrome para descobrir seus perfis. O perfil local escolhido pode servir como origem ou destino de sincronização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer de Chrome-map om uw profielen te ontdekken. Het gekozen lokale profiel kan dienen als synchronisatiebron of doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder Chrome, aby odkryć swoje profile. Wybrany profil lokalny może służyć jako źródło lub cel synchronizacji."
          }
        }
      }
    },
