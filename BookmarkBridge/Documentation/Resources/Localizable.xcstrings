    "help.history.available.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home and Preview are reloaded after a sync or restore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil et l’aperçu sont rechargés après une synchronisation ou une restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio y Vista previa se recargan después de una sincronización o restauración."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startseite und Vorschau werden nach einer Synchronisierung oder Wiederherstellung neu geladen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Home e l'anteprima vengono ricaricate dopo una sincronizzazione o un ripristino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Home e Preview são recarregados após uma sincronização ou restauração."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Home en Preview worden opnieuw geladen na een synchronisatie of herstel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona główna i podgląd są ładowane ponownie po synchronizacji lub przywróceniu."
          }
        }
      }
    },
    "help.history.available.result": {
