            "state": "translated",
            "value": "Safari und Chrome müssen während des Schreibens oder Wiederherstellens geschlossen sein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari e Chrome devono essere chiusi durante la scrittura o il ripristino."
          }
        },
        "pt": {
