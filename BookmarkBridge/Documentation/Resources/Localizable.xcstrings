    "help.installation.requirements": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 requires macOS 26.5 or later. The application works on Apple Silicon and Intel 64-bit Macs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 nécessite macOS 26.5 ou une version ultérieure. L’application fonctionne sur les Mac Apple Silicon et Intel 64 bits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 requiere macOS 26.5 o posterior. La aplicación funciona en Mac Apple Silicon e Intel de 64 bits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 erfordert macOS 26.5 oder höher. Die Anwendung funktioniert auf Apple Silicon- und Intel 64-Bit-Macs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 richiede macOS 26.5 o successivo. L'applicazione funziona su Mac Apple Silicon e Intel a 64 bit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 requer macOS 26.5 ou posterior. O aplicativo funciona em Macs Apple Silicon e Intel de 64 bits."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 vereist macOS 26.5 of hoger. De applicatie werkt op Apple Silicon en Intel 64-bit Macs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 wymaga systemu macOS 26.5 lub nowszego. Aplikacja działa na 64-bitowych komputerach Mac Apple Silicon i Intel."
          }
        }
      }
    },
