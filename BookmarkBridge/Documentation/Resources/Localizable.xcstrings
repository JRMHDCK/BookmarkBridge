    "about.promise.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge previews changes and protects data before syncing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge prévisualise les changements et protège les données avant toute synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge previsualiza los cambios y protege los datos antes de sincronizarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge zeigt Änderungen in der Vorschau an und schützt Daten vor der Synchronisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge visualizza in anteprima le modifiche e protegge i dati prima della sincronizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge visualiza alterações e protege os dados antes da sincronização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge bekijkt wijzigingen vooraf en beschermt gegevens voordat deze worden gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge wyświetla podgląd zmian i chroni dane przed synchronizacją."
          }
        }
      }
    },
