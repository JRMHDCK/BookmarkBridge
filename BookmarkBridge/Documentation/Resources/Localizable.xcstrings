    "help.faq.missing.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elements already present after URL normalization are not added again. AccountBookmarks stores and ambiguous profiles also remain read-only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments déjà présents après normalisation d’URL ne sont pas ajoutés à nouveau. Les stockages AccountBookmarks et les profils ambigus restent également en lecture seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos que ya están presentes después de la normalización de la URL no se vuelven a agregar. Las tiendas AccountBookmarks y los perfiles ambiguos también siguen siendo de sólo lectura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der URL-Normalisierung bereits vorhandene Elemente werden nicht erneut hinzugefügt. AccountBookmarks-Stores und mehrdeutige Profile bleiben ebenfalls schreibgeschützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi già presenti dopo la normalizzazione dell'URL non vengono aggiunti nuovamente. Anche i negozi AccountBookmarks e i profili ambigui rimangono di sola lettura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os elementos já presentes após a normalização da URL não são adicionados novamente. As lojas AccountBookmarks e perfis ambíguos também permanecem somente leitura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementen die al aanwezig zijn na URL-normalisatie, worden niet opnieuw toegevoegd. AccountBookmarks-winkels en dubbelzinnige profielen blijven ook alleen-lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy już obecne po normalizacji adresu URL nie są dodawane ponownie. Sklepy AccountBookmarks i niejednoznaczne profile również pozostają tylko do odczytu."
          }
        }
      }
    },
    "help.faq.missing.question": {
