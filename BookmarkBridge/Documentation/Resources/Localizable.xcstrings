            "value": "Risoluzione dei problemi"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solução de problemas"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Problemen oplossen"
          }
        },
        "pl": {
          "stringUnit": {
