    "help.faq.duplicateFolder.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two folders can have the same name but belong to different locations. BookmarkBridge maintains this distinction and does not attempt to merge them based on name alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux dossiers peuvent porter le même nom tout en appartenant à des emplacements différents. BookmarkBridge conserve cette distinction et n’essaie pas de les fusionner d’après leur nom seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos carpetas pueden tener el mismo nombre pero pertenecer a ubicaciones diferentes. BookmarkBridge mantiene esta distinción y no intenta fusionarlos basándose únicamente en el nombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Ordner können denselben Namen haben, aber zu unterschiedlichen Speicherorten gehören. BookmarkBridge behält diese Unterscheidung bei und versucht nicht, sie allein aufgrund des Namens zusammenzuführen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due cartelle possono avere lo stesso nome ma appartenere a posizioni diverse. BookmarkBridge mantiene questa distinzione e non tenta di unirli solo in base al nome."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas pastas podem ter o mesmo nome, mas pertencer a locais diferentes. BookmarkBridge mantém essa distinção e não tenta mesclá-los apenas com base no nome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee mappen kunnen dezelfde naam hebben, maar tot verschillende locaties behoren. BookmarkBridge handhaaft dit onderscheid en probeert ze niet alleen op basis van de naam samen te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa foldery mogą mieć tę samą nazwę, ale należeć do różnych lokalizacji. BookmarkBridge zachowuje to rozróżnienie i nie próbuje ich łączyć na podstawie samej nazwy."
          }
        }
      }
    },
