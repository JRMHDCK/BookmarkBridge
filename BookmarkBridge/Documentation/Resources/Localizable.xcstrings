    "browserClosure.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To prevent concurrent changes or bookmark corruption, Safari and Chrome must be closed before this operation. Browsers to close: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter les modifications simultanées ou la corruption des favoris, Safari et Chrome doivent être fermés avant cette opération. Navigateurs à fermer : %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar cambios simultáneos o daños en los marcadores, se deben cerrar Safari y Chrome antes de esta operación. Navegadores para cerrar: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gleichzeitige Änderungen oder die Beschädigung von Lesezeichen zu verhindern, müssen Safari und Chrome vor diesem Vorgang geschlossen werden. Zu schließende Browser: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per evitare modifiche simultanee o corruzione dei segnalibri, Safari e Chrome devono essere chiusi prima di questa operazione. Browser da chiudere: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar alterações simultâneas ou corrupção de favoritos, o Safari e o Chrome devem ser fechados antes desta operação. Navegadores a serem fechados: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om gelijktijdige wijzigingen of corruptie van bladwijzers te voorkomen, moeten Safari en Chrome vóór deze handeling worden afgesloten. Browsers om te sluiten: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zapobiec jednoczesnym zmianom lub uszkodzeniu zakładek, przed tą operacją należy zamknąć przeglądarki Safari i Chrome. Przeglądarki do zamknięcia: %@."
          }
        }
      }
    },
