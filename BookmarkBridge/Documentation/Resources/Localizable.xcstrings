    "onboarding.finish.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie anschließend die Safari- und Chrome-Dateien aus. BookmarkBridge führt Sie dann durch Auswahl, Richtung und Vorschau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next, choose the Safari and Chrome files. BookmarkBridge will then guide you through selection, direction, and preview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación, elija los archivos de Safari y Chrome. BookmarkBridge le guiará por la selección, la dirección y la vista previa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ensuite les fichiers Safari et Chrome. BookmarkBridge vous guidera alors dans la sélection, le sens et l’aperçu."
          }
        },
        "it" : {
