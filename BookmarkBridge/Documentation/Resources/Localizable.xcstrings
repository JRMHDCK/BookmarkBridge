            "value": "Rozwiązywanie problemów"
          }
        }
      }
    },
    "help.profiles.ambiguous.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a profile has both Bookmarks and AccountBookmarks with data, BookmarkBridge flags this and denies writing so as not to choose arbitrarily."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un profil possède à la fois Bookmarks et AccountBookmarks avec des données, BookmarkBridge le signale et refuse l’écriture afin de ne pas choisir arbitrairement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un perfil tiene tanto Marcadores como Marcadores de cuenta con datos, BookmarkBridge lo marca y niega la escritura para no elegir arbitrariamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Profil sowohl Lesezeichen als auch AccountBookmarks mit Daten enthält, markiert BookmarkBridge dies und verweigert das Schreiben, um nicht willkürlich auszuwählen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un profilo ha sia Segnalibri che AccountBookmarks con dati, BookmarkBridge lo segnala e nega la scrittura per non scegliere arbitrariamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um perfil possui Bookmarks e AccountBookmarks com dados, BookmarkBridge sinaliza isso e nega a gravação para não escolher arbitrariamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een profiel zowel Bookmarks als AccountBookmarks met gegevens bevat, markeert BookmarkBridge dit en weigert te schrijven om niet willekeurig te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli profil zawiera zarówno zakładki, jak i zakładki konta z danymi, BookmarkBridge flaguje to i blokuje zapis, aby nie dokonywać arbitralnego wyboru."
          }
        }
      }
    },
    "help.profiles.ambiguous.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two non-empty storages"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux stockages non vides"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos almacenes no vacíos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei nicht leere Speicher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due magazzini non vuoti"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois armazenamentos não vazios"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee niet-lege opslagruimtes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa niepuste magazyny"
          }
        }
      }
    },
    "help.profiles.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each Chrome profile has its own name and storage. Always check the profile displayed in the preview before syncing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil Chrome possède son propre nom et son propre stockage. Vérifiez toujours le profil affiché dans l’aperçu avant de synchroniser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil de Chrome tiene su propio nombre y almacenamiento. Verifique siempre el perfil que se muestra en la vista previa antes de sincronizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Chrome-Profil hat seinen eigenen Namen und Speicher. Überprüfen Sie vor der Synchronisierung immer das in der Vorschau angezeigte Profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni profilo Chrome ha il proprio nome e spazio di archiviazione. Controlla sempre il profilo visualizzato nell'anteprima prima della sincronizzazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil do Chrome tem seu próprio nome e armazenamento. Sempre verifique o perfil exibido na visualização antes de sincronizar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk Chrome-profiel heeft zijn eigen naam en opslag. Controleer altijd het profiel dat in het voorbeeld wordt weergegeven voordat u gaat synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil Chrome ma swoją nazwę i miejsce na dane. Przed synchronizacją zawsze sprawdź profil wyświetlany w podglądzie."
          }
        }
      }
    },
    "help.profiles.selection.account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Profile: AccountBookmarks is read but remains read-only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil de compte : AccountBookmarks est lu mais reste en lecture seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil de cuenta: AccountBookmarks se lee pero sigue siendo de solo lectura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoprofil: AccountBookmarks wird gelesen, bleibt aber schreibgeschützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo account: AccountBookmarks viene letto ma rimane di sola lettura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil da conta: AccountBookmarks é lido, mas permanece somente leitura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountprofiel: AccountBookmarks wordt gelezen maar blijft alleen-lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil konta: Zakładki konta są czytane, ale pozostają tylko do odczytu."
          }
        }
      }
    },
    "help.profiles.selection.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local profile: The Bookmarks file can be selected as source or target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil local : le fichier Bookmarks peut être sélectionné comme source ou comme cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil local: el archivo de marcadores se puede seleccionar como origen o destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Profil: Die Lesezeichendatei kann als Quelle oder Ziel ausgewählt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo locale: il file dei segnalibri può essere selezionato come origine o destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil local: O arquivo de favoritos pode ser selecionado como origem ou destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaal profiel: Het bladwijzerbestand kan als bron of doel worden geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil lokalny: plik zakładek można wybrać jako źródłowy lub docelowy."
          }
        }
      }
    },
    "help.profiles.selection.multiple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple profiles: Each appears as a separate library and can be chosen as source or target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs profils : chacun apparaît comme une bibliothèque distincte et peut être choisi comme source ou cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Múltiples perfiles: cada uno aparece como una biblioteca separada y se puede elegir como origen o destino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Profile: Jedes erscheint als separate Bibliothek und kann als Quelle oder Ziel ausgewählt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili multipli: ciascuno appare come una libreria separata e può essere scelto come origine o destinazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários perfis: cada um aparece como uma biblioteca separada e pode ser escolhido como origem ou destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerdere profielen: Elk verschijnt als een afzonderlijke bibliotheek en kan als bron of doel worden gekozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele profili: każdy pojawia się jako osobna biblioteka i można go wybrać jako źródłowy lub docelowy."
          }
        }
      }
    },
