    "help.faq.profiles.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge can read multiple profiles, but each sync uses a specific local Chrome profile as the source or target. Check its name and chosen meaning in the preview before confirming."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge peut lire plusieurs profils, mais chaque synchronisation utilise un profil Chrome local précis comme source ou cible. Vérifiez son nom et le sens choisi dans l’aperçu avant de confirmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge puede leer varios perfiles, pero cada sincronización utiliza un perfil local específico de Chrome como origen o destino. Comprueba su nombre y significado elegido en la vista previa antes de confirmar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge kann mehrere Profile lesen, aber jede Synchronisierung verwendet ein bestimmtes lokales Chrome-Profil als Quelle oder Ziel. Überprüfen Sie vor der Bestätigung den Namen und die gewählte Bedeutung in der Vorschau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge può leggere più profili, ma ogni sincronizzazione utilizza un profilo Chrome locale specifico come origine o destinazione. Controlla il nome e il significato scelto nell'anteprima prima di confermare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge pode ler vários perfis, mas cada sincronização usa um perfil local específico do Chrome como origem ou destino. Verifique seu nome e significado escolhido na visualização antes de confirmar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge kan meerdere profielen lezen, maar elke synchronisatie gebruikt een specifiek lokaal Chrome-profiel als bron of doel. Controleer de naam en de gekozen betekenis in het voorbeeld voordat u bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge może odczytywać wiele profili, ale każda synchronizacja wykorzystuje określony lokalny profil Chrome jako źródło lub cel. Przed zatwierdzeniem sprawdź jego nazwę i wybrane znaczenie w podglądzie."
          }
        }
      }
    },
