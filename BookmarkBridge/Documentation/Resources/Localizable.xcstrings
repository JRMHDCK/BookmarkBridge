{
  "sourceLanguage": "en",
  "strings": {
    "about.acknowledgements.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks to the Swift and Chromium communities, and to the users who help make BookmarkBridge more reliable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci aux communautés Swift et Chromium, ainsi qu’aux utilisateurs qui contribuent à rendre BookmarkBridge plus fiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias a las comunidades Swift y Chromium, y a los usuarios que ayudan a que BookmarkBridge sea más confiable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank an die Swift- und Chromium-Communitys und an die Benutzer, die dazu beitragen, BookmarkBridge zuverlässiger zu machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie alle community Swift e Chromium e agli utenti che contribuiscono a rendere BookmarkBridge più affidabile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado às comunidades Swift e Chromium e aos usuários que ajudam a tornar o BookmarkBridge mais confiável."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dank aan de Swift- en Chromium-gemeenschappen, en aan de gebruikers die BookmarkBridge betrouwbaarder maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy społecznościom Swift i Chromium oraz użytkownikom, którzy pomagają zwiększyć niezawodność BookmarkBridge."
          }
        }
      }
    },
