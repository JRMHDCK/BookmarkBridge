    "manual.clickOpenAnywayMacOSMayAskFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Open Anyway. macOS may ask for your password or Touch ID. BookmarkBridge will then open normally."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir quand même. macOS peut demander votre mot de passe ou Touch ID. BookmarkBridge s’ouvrira ensuite normalement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic en Abrir de todos modos. macOS puede solicitar su contraseña o Touch ID. BookmarkBridge se abrirá normalmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf „Trotzdem öffnen“. macOS fragt möglicherweise nach Ihrem Passwort oder Ihrer Touch ID. BookmarkBridge wird dann normal geöffnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic su Apri comunque. macOS potrebbe richiedere la tua password o Touch ID. BookmarkBridge si aprirà quindi normalmente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Abrir mesmo assim. O macOS pode solicitar sua senha ou Touch ID. BookmarkBridge abrirá normalmente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op Toch openen. macOS vraagt ​​mogelijk om uw wachtwoord of Touch ID. BookmarkBridge wordt dan normaal geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
