    "manual.closeSafariAndChromeOpenTheLatest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Safari and Chrome, open the latest sync result, choose Restore and confirm. The dashboard is then reloaded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez Safari et Chrome, ouvrez le dernier résultat de synchronisation, choisissez Restaurer et confirmez. Le tableau de bord est ensuite rechargé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre Safari y Chrome, abra el último resultado de sincronización, elija Restaurar y confirme. Luego se recarga el tablero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie Safari und Chrome, öffnen Sie das neueste Synchronisierungsergebnis, wählen Sie „Wiederherstellen“ und bestätigen Sie. Anschließend wird das Dashboard neu geladen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Safari e Chrome, apri l'ultimo risultato di sincronizzazione, scegli Ripristina e conferma. La dashboard viene quindi ricaricata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o Safari e o Chrome, abra o resultado de sincronização mais recente, escolha Restaurar e confirme. O painel é então recarregado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Safari en Chrome, open het laatste synchronisatieresultaat, kies Herstellen en bevestig. Het dashboard wordt vervolgens opnieuw geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij Safari i Chrome, otwórz najnowszy wynik synchronizacji, wybierz Przywróć i potwierdź. Następnie pulpit nawigacyjny zostanie ponownie załadowany."
          }
        }
      }
    },
