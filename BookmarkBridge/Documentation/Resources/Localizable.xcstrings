          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram detectados dois armazenamentos de favoritos (Bookmarks + AccountBookmarks). Nenhuma escolha segura pode ser feita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn twee bladwijzerwinkels gedetecteerd (Bladwijzers + AccountBookmarks). Er kan geen veilige keuze worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto dwa sklepy z zakładkami (Zakładki + Zakładki konta). Nie można dokonać bezpiecznego wyboru."
          }
        }
      }
    },
