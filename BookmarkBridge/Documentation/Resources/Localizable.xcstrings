            "value": "Restore a backup"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer une sauvegarde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar una copia de seguridad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie ein Backup wieder her"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina un backup"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar um backup"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel een back-up"
          }
        },
        "pl": {
          "stringUnit": {
