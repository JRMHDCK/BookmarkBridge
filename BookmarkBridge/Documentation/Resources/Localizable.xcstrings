    "manual.bookmarkbridgeDoesNotDependOnAnyOnline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge does not depend on any online account and does not send your bookmarks to a remote service."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge ne dépend d’aucun compte en ligne et n’envoie pas vos favoris vers un service distant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge no depende de ninguna cuenta en línea y no envía sus favoritos a un servicio remoto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge ist nicht auf ein Online-Konto angewiesen und sendet Ihre Lesezeichen nicht an einen Remote-Dienst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge non dipende da alcun account online e non invia i tuoi segnalibri a un servizio remoto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge não depende de nenhuma conta online e não envia seus favoritos para um serviço remoto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge is niet afhankelijk van een online account en stuurt uw bladwijzers niet naar een externe service."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge nie jest zależny od żadnego konta internetowego i nie wysyła Twoich zakładek do zdalnej usługi."
          }
        }
      }
    },
    "manual.bookmarkbridgeIsANativeMacOSAppThat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge is a native macOS app that syncs Safari and Google Chrome bookmarks back and forth, after a controlled preview."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge est une application macOS native qui synchronise les favoris de Safari et de Google Chrome dans les deux sens, après un aperçu contrôlé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge es una aplicación nativa de macOS que sincroniza los marcadores de Safari y Google Chrome de un lado a otro, después de una vista previa controlada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge ist eine native macOS-App, die Safari- und Google Chrome-Lesezeichen nach einer kontrollierten Vorschau hin und her synchronisiert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge è un'app macOS nativa che sincronizza avanti e indietro i segnalibri di Safari e Google Chrome, dopo un'anteprima controllata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge é um aplicativo macOS nativo que sincroniza os favoritos do Safari e do Google Chrome entre si, após uma visualização controlada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge is een native macOS-app die Safari- en Google Chrome-bladwijzers heen en weer synchroniseert, na een gecontroleerd voorbeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge to natywna aplikacja dla systemu MacOS, która synchronizuje zakładki Safari i Google Chrome tam i z powrotem po kontrolowanym podglądzie."
          }
        }
      }
    },
