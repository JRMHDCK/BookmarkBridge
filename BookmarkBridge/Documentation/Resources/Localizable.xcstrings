    "manual.bookmarkbridge091BetaRequiresMacOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta requires macOS 26.5 or later and runs on 64-bit Apple Silicon and Intel Macs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta nécessite macOS 26.5 ou une version ultérieure et fonctionne sur les Mac Apple Silicon et Intel 64 bits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta requiere macOS 26.5 o posterior y se ejecuta en Mac Apple Silicon e Intel de 64 bits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta erfordert macOS 26.5 oder höher und läuft auf 64-Bit-Macs von Apple Silicon und Intel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta richiede macOS 26.5 o successivo e funziona su Mac Apple Silicon e Intel a 64 bit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta requer macOS 26.5 ou posterior e roda em Apple Silicon de 64 bits e Macs Intel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Bèta vereist macOS 26.5 of hoger en draait op 64-bit Apple Silicon en Intel Macs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge 0.9.1 Beta wymaga systemu macOS 26.5 lub nowszego i działa na 64-bitowych komputerach Apple Silicon i Intel Mac."
          }
        }
      }
    },
    "manual.bookmarkbridgeAutomaticallyReloadsTheDashboardAndPreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge automatically reloads the dashboard and preview. A second execution, without further modification, should show zero operations."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge recharge automatiquement le tableau de bord et l’aperçu. Une seconde exécution, sans nouvelle modification, doit afficher zéro opération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge recarga automáticamente el panel y obtiene una vista previa. Una segunda ejecución, sin más modificaciones, debería mostrar cero operaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge lädt das Dashboard und die Vorschau automatisch neu. Bei einer zweiten Ausführung ohne weitere Änderungen sollten keine Vorgänge angezeigt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge ricarica automaticamente la dashboard e l'anteprima. Una seconda esecuzione, senza ulteriori modifiche, dovrebbe mostrare zero operazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge recarrega automaticamente o painel e a visualização. Uma segunda execução, sem modificações adicionais, deverá mostrar zero operações."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge laadt automatisch het dashboard en het voorbeeld opnieuw. Een tweede uitvoering, zonder verdere wijzigingen, zou nul operaties moeten opleveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BookmarkBridge automatycznie ponownie ładuje pulpit nawigacyjny i podgląd. Drugie wykonanie, bez dalszych modyfikacji, powinno pokazać zerowe operacje."
          }
        }
      }
    },
