    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your bookmarks from Safari to Chrome or from Chrome to Safari with a clear preview, explicit confirmation and automatic backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos favoris de Safari vers Chrome ou de Chrome vers Safari avec un aperçu clair, une confirmation explicite et une sauvegarde automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus favoritos de Safari a Chrome o de Chrome a Safari con una vista previa clara, confirmación explícita y copia de seguridad automática."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisieren Sie Ihre Lesezeichen von Safari zu Chrome oder von Chrome zu Safari mit einer klaren Vorschau, expliziter Bestätigung und automatischer Sicherung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza i tuoi segnalibri da Safari a Chrome o da Chrome a Safari con un'anteprima chiara, conferma esplicita e backup automatico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize seus favoritos do Safari para o Chrome ou do Chrome para o Safari com uma visualização clara, confirmação explícita e backup automático."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer uw bladwijzers van Safari naar Chrome of van Chrome naar Safari met een duidelijk voorbeeld, expliciete bevestiging en automatische back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj swoje zakładki z Safari do Chrome lub z Chrome do Safari z wyraźnym podglądem, wyraźnym potwierdzeniem i automatyczną kopią zapasową."
          }
        }
      }
    },
