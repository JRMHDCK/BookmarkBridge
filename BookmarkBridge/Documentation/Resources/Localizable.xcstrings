    "help.glossary.bidirectional.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Executable sync from Safari to Chrome or Chrome to Safari, whichever direction you choose before previewing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation exécutable de Safari vers Chrome ou de Chrome vers Safari, selon le sens choisi avant l’aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización ejecutable de Safari a Chrome o de Chrome a Safari, en cualquier dirección que elija antes de obtener una vista previa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführbare Synchronisierung von Safari zu Chrome oder von Chrome zu Safari, je nachdem, welche Richtung Sie vor der Vorschau wählen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione eseguibile da Safari a Chrome o da Chrome a Safari, a seconda della direzione scelta prima dell'anteprima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronização executável do Safari para o Chrome ou do Chrome para o Safari, na direção que você escolher antes da visualização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitvoerbare synchronisatie van Safari naar Chrome of Chrome naar Safari, welke richting u ook kiest voordat u een voorbeeld bekijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonywalna synchronizacja z Safari do Chrome lub Chrome do Safari, w zależności od kierunku wybranego przed podglądem."
          }
        }
      }
    },
