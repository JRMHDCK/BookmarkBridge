    "help.synchronization.step.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sync, choose Safari to Chrome or Chrome to Safari, and review the summary and changes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Synchronisation, choisissez Safari vers Chrome ou Chrome vers Safari, puis examinez le résumé et les changements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Sincronización, elija Safari a Chrome o Chrome a Safari y revise el resumen y los cambios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie „Sync“, wählen Sie „Safari zu Chrome“ oder „Chrome zu Safari“ und überprüfen Sie die Zusammenfassung und die Änderungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Sync, scegli Safari in Chrome o Chrome in Safari e rivedi il riepilogo e le modifiche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Sync, escolha Safari para Chrome ou Chrome para Safari e revise o resumo e as alterações."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sync, kies Safari naar Chrome of Chrome naar Safari en bekijk het overzicht en de wijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Synchronizuj, wybierz Safari z Chrome lub Chrome z Safari i przejrzyj podsumowanie i zmiany."
          }
        }
      }
    },
    "help.synchronization.step.verify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the success message and verify that the preview reloads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez le message de réussite et vérifiez que l’aperçu se recharge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere el mensaje de éxito y verifique que la vista previa se vuelva a cargar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie auf die Erfolgsmeldung und überprüfen Sie, ob die Vorschau neu geladen wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il messaggio di successo e verifica che l'anteprima si ricarichi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a mensagem de sucesso e verifique se a visualização é recarregada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op het succesbericht en controleer of het voorbeeld opnieuw wordt geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na komunikat o powodzeniu i sprawdź, czy podgląd zostanie ponownie załadowany."
          }
        }
      }
    },
