    "manual.previewReadableSimulationOfChangesWithoutWriting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Preview</b>: readable simulation of changes, without writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Aperçu</b> : simulation lisible des changements, sans écriture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Vista previa</b>: simulación legible de cambios, sin escritura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Vorschau</b>: lesbare Simulation von Änderungen, ohne Schreiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Anteprima</b>: simulazione leggibile delle modifiche, senza scrittura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Pré-visualização</b>: simulação legível de alterações, sem escrita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Voorbeeld</b>: leesbare simulatie van wijzigingen, zonder te schrijven."
