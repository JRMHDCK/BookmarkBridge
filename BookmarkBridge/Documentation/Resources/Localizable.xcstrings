    "manual.safariAndChromeMustBeClosedWhile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari and Chrome must be closed while writing or restoring."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari et Chrome doivent être fermés pendant l’écriture ou la restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari y Chrome deben estar cerrados mientras se escribe o se restaura."
          }
        },
